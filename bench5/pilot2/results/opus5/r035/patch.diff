+func TestStore_Build_ManifestVersion(t *testing.T) {
+	for _, test := range []struct {
+		name              string
+		opts              []containers.Option[StoreOptions]
+		expectedMediaType string
+	}{
+		{
+			name:              "default is 1.1",
+			expectedMediaType: v1.MediaTypeEmptyJSON,
+		},
+		{
+			name:              "1.0",
+			opts:              []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)},
+			expectedMediaType: MediaTypeFliptFeatures,
+		},
+		{
+			name:              "1.1",
+			opts:              []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_1)},
+			expectedMediaType: v1.MediaTypeEmptyJSON,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.TODO()
+			dir := testRepository(t)
+
+			ref, err := ParseReference(fmt.Sprintf("flipt://local/%s:latest", repo))
+			require.NoError(t, err)
+
+			store, err := NewStore(zaptest.NewLogger(t), dir, test.opts...)
+			require.NoError(t, err)
+
+			testdata, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+
+			bundle, err := store.Build(ctx, testdata, ref)
+			require.NoError(t, err)
+
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+
+			rd, err := target.Fetch(ctx, v1.Descriptor{
+				MediaType: v1.MediaTypeImageManifest,
+				Digest:    bundle.Digest,
+			})
+			require.NoError(t, err)
+			defer rd.Close()
+
+			var manifest v1.Manifest
+			require.NoError(t, json.NewDecoder(rd).Decode(&manifest))
+
+			// the config media type is how oras distinguishes the packed
+			// manifest version: 1.0 carries the artifact type on the config
+			// descriptor, 1.1 carries it on the manifest itself
+			assert.Equal(t, test.expectedMediaType, manifest.Config.MediaType)
+		})
+	}
+}
