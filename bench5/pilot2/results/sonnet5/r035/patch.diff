+func TestStore_Build_ManifestVersion(t *testing.T) {
+	for _, test := range []struct {
+		name            string
+		manifestVersion oras.PackManifestVersion
+		// wantConfigMediaType is the media type used for the descriptor
+		// so it can be used to distinguish between manifest versions
+		wantConfigMediaType string
+		wantArtifactType    string
+	}{
+		{
+			name:                "default (1.1)",
+			manifestVersion:     0,
+			wantConfigMediaType: "application/vnd.oci.empty.v1+json",
+			wantArtifactType:    MediaTypeFliptFeatures,
+		},
+		{
+			name:                "explicit 1.1",
+			manifestVersion:     oras.PackManifestVersion1_1,
+			wantConfigMediaType: "application/vnd.oci.empty.v1+json",
+			wantArtifactType:    MediaTypeFliptFeatures,
+		},
+		{
+			name:                "explicit 1.0",
+			manifestVersion:     oras.PackManifestVersion1_0,
+			wantConfigMediaType: MediaTypeFliptFeatures,
+			wantArtifactType:    "",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.TODO()
+			dir := testRepository(t)
+
+			ref, err := ParseReference(fmt.Sprintf("flipt://local/%s:latest", repo))
+			require.NoError(t, err)
+
+			var opts []containers.Option[StoreOptions]
+			if test.manifestVersion != 0 {
+				opts = append(opts, WithManifestVersion(test.manifestVersion))
+			}
+
+			store, err := NewStore(zaptest.NewLogger(t), dir, opts...)
+			require.NoError(t, err)
+
+			testdata, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+
+			bundle, err := store.Build(ctx, testdata, ref)
+			require.NoError(t, err)
+
+			target, err := oci.New(path.Join(dir, repo))
+			require.NoError(t, err)
+
+			rc, err := target.Fetch(ctx, v1.Descriptor{
+				Digest:    bundle.Digest,
+				MediaType: v1.MediaTypeImageManifest,
+			})
+			require.NoError(t, err)
+			defer rc.Close()
+
+			manifestBytes, err := io.ReadAll(rc)
+			require.NoError(t, err)
+
+			var manifest v1.Manifest
+			require.NoError(t, json.Unmarshal(manifestBytes, &manifest))
+
+			assert.Equal(t, test.wantConfigMediaType, manifest.Config.MediaType)
+			assert.Equal(t, test.wantArtifactType, manifest.ArtifactType)
+		})
+	}
+}
