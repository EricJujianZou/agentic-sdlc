+// buildKEVs builds a combined, normalized list of KEV entries from the CISA and VulnCheck sources of resp
+func buildKEVs(resp kevulndb.Response) []models.KEV {
+	var kevs []models.KEV
+
+	for _, c := range resp.CISA {
+		var dueDate *time.Time
+		if !c.DueDate.IsZero() {
+			d := c.DueDate
+			dueDate = &d
+		}
+		kevs = append(kevs, models.KEV{
+			Type:                       models.CISAKEVType,
+			VendorProject:              c.VendorProject,
+			Product:                    c.Product,
+			VulnerabilityName:          c.VulnerabilityName,
+			ShortDescription:           c.ShortDescription,
+			RequiredAction:             c.RequiredAction,
+			KnownRansomwareCampaignUse: c.KnownRansomwareCampaignUse,
+			DateAdded:                  c.DateAdded,
+			DueDate:                    dueDate,
+			CISA: &models.CISAKEV{
+				Note: c.Notes,
+			},
+		})
+	}
+
+	for _, vc := range resp.VulnCheck {
+		xdbs := make([]models.VulnCheckXDB, 0, len(vc.VulnCheckXDB))
+		for _, x := range vc.VulnCheckXDB {
+			xdbs = append(xdbs, models.VulnCheckXDB{
+				XDBID:       x.XDBID,
+				XDBURL:      x.XDBURL,
+				DateAdded:   x.DateAdded,
+				ExploitType: x.ExploitType,
+				CloneSSHURL: x.CloneSSHURL,
+			})
+		}
+		reported := make([]models.VulnCheckReportedExploitation, 0, len(vc.VulnCheckReportedExploitation))
+		for _, re := range vc.VulnCheckReportedExploitation {
+			reported = append(reported, models.VulnCheckReportedExploitation{
+				URL:       re.URL,
+				DateAdded: re.DateAdded,
+			})
+		}
+		kevs = append(kevs, models.KEV{
+			Type:                       models.VulnCheckKEVType,
+			VendorProject:              vc.VendorProject,
+			Product:                    vc.Product,
+			VulnerabilityName:          vc.Name,
+			ShortDescription:           vc.Description,
+			RequiredAction:             vc.RequiredAction,
+			KnownRansomwareCampaignUse: vc.KnownRansomwareCampaignUse,
+			DateAdded:                  vc.DateAdded,
+			DueDate:                    vc.DueDate,
+			VulnCheck: &models.VulnCheckKEV{
+				XDB:                  xdbs,
+				ReportedExploitation: reported,
+			},
+		})
+	}
+
+	return kevs
+}
