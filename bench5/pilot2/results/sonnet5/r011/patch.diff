 }
 
+// FormatKEVCveSummary returns a summary of Known Exploited Vulnerabilities
+func (r ScanResult) FormatKEVCveSummary() string {
+	nKEVCve := 0
+	for _, vuln := range r.ScannedCves {
+		if 0 < len(vuln.KEVs) {
+			nKEVCve++
+		}
+	}
+	return fmt.Sprintf("%d KEVs", nKEVCve)
+}
