@@ -390,6 +390,24 @@ class Block(Base, Conditional, CollectionSearch, Taggable):
     def has_tasks(self):
         return len(self.block) > 0 or len(self.rescue) > 0 or len(self.always) > 0
 
+    def get_tasks(self):
+        '''
+        Returns a flattened, ordered list of all tasks in this block, spanning
+        the block/rescue/always sections and expanding any nested Block
+        instances found within them.
+        '''
+
+        def _flatten(task_list):
+            flattened = []
+            for task in task_list:
+                if isinstance(task, Block):
+                    flattened.extend(task.get_tasks())
+                else:
+                    flattened.append(task)
+            return flattened
+
+        return _flatten(self.block) + _flatten(self.rescue) + _flatten(self.always)
+
     def get_include_params(self):
         if self._parent:
             return self._parent.get_include_params()
