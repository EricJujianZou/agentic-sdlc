+func TestStore_BuildManifestVersion(t *testing.T) {
+	ctx := context.TODO()
+
+	for _, test := range []struct {
+		name                    string
+		opts                    []containers.Option[StoreOptions]
+		expectedArtifactType    string
+		expectedConfigMediaType string
+	}{
+		{
+			// manifest version 1.1 is the default when none is configured
+			name:                    "default",
+			expectedArtifactType:    MediaTypeFliptFeatures,
+			expectedConfigMediaType: v1.MediaTypeEmptyJSON,
+		},
+		{
+			name:                    "manifest version 1.0",
+			opts:                    []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_0)},
+			expectedConfigMediaType: MediaTypeFliptFeatures,
+		},
+		{
+			name:                    "manifest version 1.1",
+			opts:                    []containers.Option[StoreOptions]{WithManifestVersion(oras.PackManifestVersion1_1)},
+			expectedArtifactType:    MediaTypeFliptFeatures,
+			expectedConfigMediaType: v1.MediaTypeEmptyJSON,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			dir := testRepository(t)
+
+			ref, err := ParseReference(fmt.Sprintf("flipt://local/%s:latest", repo))
+			require.NoError(t, err)
+
+			store, err := NewStore(zaptest.NewLogger(t), dir, test.opts...)
+			require.NoError(t, err)
+
+			testdata, err := fs.Sub(testdata, "testdata")
+			require.NoError(t, err)
+
+			_, err = store.Build(ctx, testdata, ref)
+			require.NoError(t, err)
+
+			target, err := store.getTarget(ref)
+			require.NoError(t, err)
+
+			desc, err := target.Resolve(ctx, ref.Reference.Reference)
+			require.NoError(t, err)
+
+			rd, err := target.Fetch(ctx, desc)
+			require.NoError(t, err)
+
+			defer rd.Close()
+
+			var manifest v1.Manifest
+			require.NoError(t, json.NewDecoder(rd).Decode(&manifest))
+
+			assert.Equal(t, test.expectedArtifactType, manifest.ArtifactType)
+			assert.Equal(t, test.expectedConfigMediaType, manifest.Config.MediaType)
+		})
+	}
+}
