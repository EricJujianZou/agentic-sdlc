+func TestRegister_confirmAndRollback(t *testing.T) {
+	n := *touchid.Native
+	t.Cleanup(func() {
+		*touchid.Native = n
+	})
+
+	web, err := webauthn.New(&webauthn.Config{
+		RPDisplayName: "Teleport",
+		RPID:          "teleport",
+		RPOrigin:      "https://goteleport.com",
+	})
+	require.NoError(t, err)
+	origin := web.Config.RPOrigin
+
+	webUser := &fakeUser{id: []byte{1, 2, 3, 4, 5}, name: "llama"}
+	register := func(t *testing.T) (*fakeNative, *touchid.Registration) {
+		fake := &fakeNative{}
+		*touchid.Native = fake
+
+		cc, _, err := web.BeginRegistration(webUser)
+		require.NoError(t, err, "BeginRegistration failed")
+		reg, err := touchid.Register(origin, (*wanlib.CredentialCreation)(cc))
+		require.NoError(t, err, "Register failed")
+		require.Len(t, fake.creds, 1, "credential not created")
+		require.Equal(t, fake.creds[0].id, reg.CCR.ID, "CCR.ID mismatch")
+		return fake, reg
+	}
+
+	t.Run("rollback deletes the credential", func(t *testing.T) {
+		fake, reg := register(t)
+
+		require.NoError(t, reg.Rollback(), "Rollback failed")
+		assert.Equal(t, 1, fake.deleteNonInteractiveCount, "DeleteNonInteractive call count mismatch")
+		assert.Empty(t, fake.creds, "credential not deleted")
+
+		// Rollback is idempotent.
+		require.NoError(t, reg.Rollback(), "Rollback (2nd) failed")
+		assert.Equal(t, 1, fake.deleteNonInteractiveCount, "DeleteNonInteractive called by the 2nd Rollback")
+
+		// The credential is gone, so logins using it fail.
+		_, _, err := touchid.Login(origin, "" /* user */, &wanlib.CredentialAssertion{
+			Response: protocol.PublicKeyCredentialRequestOptions{
+				Challenge:      []byte{1, 2, 3, 4, 5},
+				RelyingPartyID: web.Config.RPID,
+			},
+		})
+		assert.ErrorIs(t, err, touchid.ErrCredentialNotFound, "Login error mismatch")
+	})
+
+	t.Run("rollback after confirm is a noop", func(t *testing.T) {
+		fake, reg := register(t)
+
+		require.NoError(t, reg.Confirm(), "Confirm failed")
+		require.NoError(t, reg.Rollback(), "Rollback failed")
+		assert.Zero(t, fake.deleteNonInteractiveCount, "DeleteNonInteractive called after Confirm")
+		assert.Len(t, fake.creds, 1, "credential deleted after Confirm")
+	})
+}
