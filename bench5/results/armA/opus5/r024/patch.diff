+// Registration represents an ongoing Touch ID registration, with an already
+// created Secure Enclave key.
+// Registrations must be explicitly Confirm-ed or Rollback-ed, as the created
+// key is orphaned until the server acknowledges it.
+type Registration struct {
+	// CCR is the credential creation response for the registration.
+	CCR *wanlib.CredentialCreationResponse
+
+	// credentialID of the Secure Enclave key backing the registration.
+	// Always equal to CCR.ID.
+	credentialID string
+
+	// done is atomically set to 1 by the first Confirm or Rollback call.
+	done int32
+}
+
+// Confirm confirms the registration.
+// Confirm is safe to call multiple times and after Rollback, in which case it
+// is a no-op.
+// May replace equivalent keys by the newly-registered key.
+func (r *Registration) Confirm() error {
+	// Keep the registration key, so a subsequent Rollback doesn't delete it.
+	atomic.StoreInt32(&r.done, 1)
+	return nil
+}
+
+// Rollback rolls back the registration, deleting the Secure Enclave key created
+// for it.
+// Rollback is safe to call multiple times and after Confirm, in which case it
+// is a no-op.
+func (r *Registration) Rollback() error {
+	if !atomic.CompareAndSwapInt32(&r.done, 0, 1) {
+		return nil
+	}
+
+	// Delete the newly-created credential.
+	return trace.Wrap(native.DeleteNonInteractive(r.credentialID))
+}
+
