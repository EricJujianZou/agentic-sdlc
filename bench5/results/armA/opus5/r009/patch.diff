+
+
+def make_list(seeds=None):
+    return List(None, "/lists/OL1L", {"seeds": seeds if seeds is not None else []})
+
+
+class TestAnnotatedSeeds:
+    def test_from_json_thing_reference(self):
+        seed = Seed.from_json(make_list(), {"key": "/books/OL1M"})
+        assert seed.key == "/books/OL1M"
+        assert seed.to_json() == {"key": "/books/OL1M"}
+        assert seed.to_db().key == "/books/OL1M"
+
+    def test_from_json_annotated(self):
+        seed = Seed.from_json(
+            make_list(), {"thing": {"key": "/books/OL1M"}, "notes": "*Great* book"}
+        )
+        assert seed.key == "/books/OL1M"
+        assert seed.notes == "*Great* book"
+        assert seed.to_json() == {
+            "thing": {"key": "/books/OL1M"},
+            "notes": "*Great* book",
+        }
+
+        db_seed = seed.to_db()
+        assert isinstance(db_seed, Thing)
+        assert db_seed.key is None
+        assert db_seed._data["thing"].key == "/books/OL1M"
+        assert db_seed._data["notes"] == "*Great* book"
+
+        # Round-trips back out of the database representation
+        assert Seed.from_db(make_list(), db_seed).to_json() == seed.to_json()
+
+    def test_empty_notes_is_a_plain_thing_reference(self):
+        seed = Seed.from_json(
+            make_list(), {"thing": {"key": "/books/OL1M"}, "notes": ""}
+        )
+        assert seed.to_json() == {"key": "/books/OL1M"}
+        assert seed.to_db().key == "/books/OL1M"
+
+    def test_subjects_are_unchanged(self):
+        seed = Seed.from_json(make_list(), "subject:love")
+        assert seed.key == "subject:love"
+        assert seed.to_json() == "subject:love"
+        assert seed.to_db() == "subject:love"
+
+    def test_seeds_are_equal_by_key(self):
+        lst = make_list()
+        assert lst.add_seed({"thing": {"key": "/books/OL1M"}, "notes": "A note"})
+        # Same key, so it's already in the list
+        assert not lst.add_seed({"key": "/books/OL1M"})
+        assert [seed.to_json() for seed in lst.get_seeds()] == [
+            {"thing": {"key": "/books/OL1M"}, "notes": "A note"}
+        ]
+        assert lst.has_seed({"key": "/books/OL1M"})
+        assert lst.remove_seed({"key": "/books/OL1M"})
+        assert lst.get_seeds() == []
