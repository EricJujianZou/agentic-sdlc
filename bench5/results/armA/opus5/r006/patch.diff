+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import * as React from "react";
+import { mount } from "enzyme";
+
+import { mkMessage, stubClient } from "../../../test-utils";
+import ReplyPreview from "../../../../src/components/views/rooms/ReplyPreview";
+import CancelButton from "../../../../src/components/views/buttons/Cancel";
+import { MatrixClientPeg } from "../../../../src/MatrixClientPeg";
+import MatrixClientContext from "../../../../src/contexts/MatrixClientContext";
+import { RoomPermalinkCreator } from "../../../../src/utils/permalinks/Permalinks";
+import dis from "../../../../src/dispatcher/dispatcher";
+
+describe("ReplyPreview", () => {
+    stubClient();
+    const client = MatrixClientPeg.get();
+    const roomId = "!roomId:server";
+    const replyToEvent = mkMessage({
+        room: roomId,
+        user: "@user1:server",
+        msg: "Hello world!",
+        event: true,
+    });
+
+    const wrapAndRender = () => mount(
+        <MatrixClientContext.Provider value={client}>
+            <ReplyPreview
+                replyToEvent={replyToEvent}
+                permalinkCreator={new RoomPermalinkCreator(null, roomId)}
+            />
+        </MatrixClientContext.Provider>,
+    );
+
+    it("names the user being replied to", () => {
+        const wrapper = wrapAndRender();
+
+        expect(wrapper.find(".mx_ReplyPreview_header").text()).toEqual("Replying to @user1:server");
+    });
+
+    it("cancels the reply when the cancel button is clicked", () => {
+        const dispatchSpy = jest.spyOn(dis, "dispatch");
+        const wrapper = wrapAndRender();
+
+        const cancelButton = wrapper.find(CancelButton);
+        expect(cancelButton).toHaveLength(1);
+        cancelButton.simulate("click");
+
+        expect(dispatchSpy).toHaveBeenCalledWith(expect.objectContaining({
+            action: "reply_to_event",
+            event: null,
+        }));
+    });
+});
