@@ -0,0 +1,21 @@
+import { ComponentType, Fragment, ReactNode, createElement } from 'react';
+
+export type HOC<T = any> = (Component: ComponentType<T>) => ComponentType<T>;
+
+/**
+ * Composes multiple HOCs into a single one.
+ */
+export const applyHOCs =
+    <T = any>(...hocs: HOC<T>[]) =>
+    (Component: ComponentType<T>): ComponentType<T> =>
+        hocs.reduce((WrappedComponent, hoc) => hoc(WrappedComponent), Component);
+
+/**
+ * Same as {@link applyHOCs} but returns a component rendering only its children, which is what the
+ * `wrapper` option of `renderHook()` expects.
+ */
+export const hookWrapper = <T = any>(...hocs: HOC<T>[]): ComponentType<T> => {
+    const Wrapper = ({ children }: { children?: ReactNode }) => createElement(Fragment, null, children);
+
+    return applyHOCs<any>(...hocs)(Wrapper);
+};
