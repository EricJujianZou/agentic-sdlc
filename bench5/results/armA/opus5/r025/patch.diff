+// TestU2FSignRequestMultipleDevices verifies that the login challenge covers
+// every registered U2F device, while still being readable by older clients
+// that only understand a single challenge.
+func TestU2FSignRequestMultipleDevices(t *testing.T) {
+	ctx := context.Background()
+	srv, err := NewTestAuthServer(TestAuthServerConfig{Dir: t.TempDir()})
+	require.NoError(t, err)
+	a := srv.AuthServer
+
+	u2fConfig := types.U2F{AppID: "teleport", Facets: []string{"teleport"}}
+	authPref, err := services.NewAuthPreference(types.AuthPreferenceSpecV2{
+		Type:         teleport.Local,
+		SecondFactor: teleport.U2F,
+		U2F:          &u2fConfig,
+	})
+	require.NoError(t, err)
+	require.NoError(t, a.SetAuthPreference(authPref))
+
+	user, _, err := CreateUserAndRole(a, "u2f-user", []string{"role"})
+	require.NoError(t, err)
+	pass := []byte("secure-password")
+	require.NoError(t, a.UpsertPassword(user.GetName(), pass))
+
+	// Register two U2F devices for the same user.
+	var wantKeyHandles []string
+	for _, devName := range []string{"u2f-dev-1", "u2f-dev-2"} {
+		key, err := mocku2f.Create()
+		require.NoError(t, err)
+		regChallenge, err := u2f.RegisterInit(u2f.RegisterInitParams{
+			AppConfig:  u2fConfig,
+			StorageKey: user.GetName(),
+			Storage:    a.Identity,
+		})
+		require.NoError(t, err)
+		regResp, err := key.RegisterResponse(regChallenge)
+		require.NoError(t, err)
+		dev, err := u2f.RegisterVerify(ctx, u2f.RegisterVerifyParams{
+			DevName:                devName,
+			Resp:                   *regResp,
+			ChallengeStorageKey:    user.GetName(),
+			RegistrationStorageKey: user.GetName(),
+			Storage:                a.Identity,
+			Clock:                  a.clock,
+		})
+		require.NoError(t, err)
+		// U2F passes key handles around base64-encoded, without padding.
+		wantKeyHandles = append(wantKeyHandles, base64.RawURLEncoding.EncodeToString(dev.GetU2F().KeyHandle))
+	}
+
+	challenge, err := a.U2FSignRequest(user.GetName(), pass)
+	require.NoError(t, err)
+
+	// One challenge per registered device.
+	var gotKeyHandles []string
+	for _, c := range challenge.Challenges {
+		gotKeyHandles = append(gotKeyHandles, c.KeyHandle)
+	}
+	sort.Strings(wantKeyHandles)
+	sort.Strings(gotKeyHandles)
+	require.Equal(t, wantKeyHandles, gotKeyHandles)
+
+	// The legacy single-device challenge is still populated and is one of the
+	// challenges above.
+	require.NotNil(t, challenge.AuthenticateChallenge)
+	require.Equal(t, challenge.Challenges[0], *challenge.AuthenticateChallenge)
+
+	// Older clients parse the payload as a bare u2f.AuthenticateChallenge; the
+	// legacy fields must stay at the top level of the JSON object.
+	buf, err := json.Marshal(challenge)
+	require.NoError(t, err)
+	var legacy u2f.AuthenticateChallenge
+	require.NoError(t, json.Unmarshal(buf, &legacy))
+	require.Equal(t, *challenge.AuthenticateChallenge, legacy)
+}
