diff --git a/src/api/main/OperationProgressTracker.ts b/src/api/main/OperationProgressTracker.ts
new file mode 100644
index 0000000..f1625c2
--- /dev/null
+++ b/src/api/main/OperationProgressTracker.ts
@@ -0,0 +1,41 @@
+import stream from "mithril/stream"
+import Stream from "mithril/stream"
+
+export type OperationId = number
+
+export type ExposedOperationProgressTracker = Pick<OperationProgressTracker, "onProgress">
+
+/**
+ * A multiplexer for tracking progress of individual async operations.
+ *
+ * In contrast to {@link ProgressTracker} the progress of the operations is not combined, each operation is tracked
+ * separately so that it can be displayed on its own (e.g. in the dialog which started the operation).
+ */
+export class OperationProgressTracker {
+	private idCounter: OperationId = 0
+	private readonly operations: Map<OperationId, Stream<number>> = new Map()
+
+	/**
+	 * Register a new operation to track its progress. The progress stream will emit values between 0 and 100.
+	 *
+	 * Make sure to call {@code done()} when the operation is finished, otherwise it will be tracked forever.
+	 */
+	registerOperation(): { id: OperationId; progress: Stream<number>; done: () => unknown } {
+		const id = this.idCounter++
+		const progress = stream(0)
+		this.operations.set(id, progress)
+		return {
+			id,
+			progress,
+			done: () => {
+				this.operations.delete(id)
+				progress.end(true)
+			},
+		}
+	}
+
+	/** Update the progress (between 0 and 100) of a single operation. Can be called from the worker. */
+	async onProgress(operation: OperationId, progressValue: number): Promise<void> {
+		this.operations.get(operation)?.(progressValue)
+	}
+}
