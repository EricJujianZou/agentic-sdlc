+    def get_with_context(self, name, *args, **kwargs):
+        ''' instantiates a plugin of the given name using arguments, returning the result and load context '''
+
+        found_in_cache = True
+        class_only = kwargs.pop('class_only', False)
+        collection_list = kwargs.pop('collection_list', None)
+        if name in self.aliases:
+            name = self.aliases[name]
+        context = self.find_plugin_with_context(name, collection_list=collection_list)
+        if not context.resolved or not context.plugin_resolved_path:
+            # FIXME: this is probably an error (eg removed plugin)
+            return get_with_context_result(None, context)
+
+        name = context.plugin_resolved_name
+        path = context.plugin_resolved_path
+        redirected_names = context.redirect_list or []
+
+        if path not in self._module_cache:
+            self._module_cache[path] = self._load_module_source(name, path)
+            self._load_config_defs(name, self._module_cache[path], path)
+            found_in_cache = False
+
+        obj = getattr(self._module_cache[path], self.class_name)
+        if self.base_class:
+            # The import path is hardcoded and should be the right place,
+            # so we are not expecting an ImportError.
+            module = __import__(self.package, fromlist=[self.base_class])
+            # Check whether this obj has the required base class.
+            try:
+                plugin_class = getattr(module, self.base_class)
+            except AttributeError:
+                return get_with_context_result(None, context)
+            if not issubclass(obj, plugin_class):
+                return get_with_context_result(None, context)
+
+        # FIXME: update this to use the load context
+        self._display_plugin_load(self.class_name, name, self._searched_paths, path, found_in_cache=found_in_cache, class_only=class_only)
+
+        if not class_only:
+            try:
+                # A plugin may need to use its _load_name in __init__ (for example, to set
+                # or get options from config), so update the object before using the constructor
+                instance = object.__new__(obj)
+                self._update_object(instance, name, path, redirected_names)
+                obj.__init__(instance, *args, **kwargs)
+                obj = instance
+            except TypeError as e:
+                if "abstract" in e.args[0]:
+                    # Abstract Base Class.  The found plugin file does not
+                    # fully implement the defined interface.
+                    return get_with_context_result(None, context)
+                raise
+
+        self._update_object(obj, name, path, redirected_names)
+        return get_with_context_result(obj, context)
+
+    def get(self, name, *args, **kwargs):
+        ''' instantiates a plugin of the given name using arguments '''
+
+        return self.get_with_context(name, *args, **kwargs).object
