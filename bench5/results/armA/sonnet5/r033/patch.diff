+
+func TestCentOSStreamToCentOS(t *testing.T) {
+	var tests = []struct {
+		in       string
+		expected string
+	}{
+		{
+			in:       "stream8",
+			expected: "8",
+		},
+		{
+			in:       "8",
+			expected: "8",
+		},
+	}
+	for i, tt := range tests {
+		a := CentOSStreamToCentOS(tt.in)
+		if tt.expected != a {
+			t.Errorf("[%d]\nexpected: %s\n  actual: %s\n", i, tt.expected, a)
+		}
+	}
+}
