+// CentOSStreamToCentOS converts a CentOS Stream release string (e.g. "stream8")
+// to the RHEL-equivalent release identifier (e.g. "8") expected by upstream
+// OVAL/Gost sources, which do not track CentOS Stream as a separate release.
+func CentOSStreamToCentOS(release string) string {
+	return strings.TrimPrefix(release, "stream")
+}
 
