+// FormatKEVCveSummary returns a summary of KEV(Known Exploited Vulnerabilities) cve
+func (r ScanResult) FormatKEVCveSummary() string {
+	nKEV := 0
+	for _, vuln := range r.ScannedCves {
+		if 0 < len(vuln.KEVs) {
+			nKEV++
+		}
+	}
+	return fmt.Sprintf("%d KEVs", nKEV)
+}
