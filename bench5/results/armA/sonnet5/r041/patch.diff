@@ -420,17 +420,24 @@ func DetectCpeURIsCves(r *models.ScanResult, cpeURIs []string, cnf config.GoCveD
 			return err
 		}
 		for _, detail := range details {
+			// NVD does not include this vendor/product, but JVN does: report it
+			// with a lower, vendor/product-only confidence instead of dropping it.
+			confidence := models.CpeVersionMatch
+			if detail.NvdJSON == nil && detail.Jvn != nil {
+				confidence = models.CpeVendorProductMatch
+			}
+
 			if val, ok := r.ScannedCves[detail.CveID]; ok {
 				names := val.CpeURIs
 				names = util.AppendIfMissing(names, name)
 				val.CpeURIs = names
-				val.Confidences.AppendIfMissing(models.CpeNameMatch)
+				val.Confidences.AppendIfMissing(confidence)
 				r.ScannedCves[detail.CveID] = val
 			} else {
 				v := models.VulnInfo{
 					CveID:       detail.CveID,
 					CpeURIs:     []string{name},
-					Confidences: models.Confidences{models.CpeNameMatch},
+					Confidences: models.Confidences{confidence},
 				}
 				r.ScannedCves[detail.CveID] = v
 				nCVEs++
