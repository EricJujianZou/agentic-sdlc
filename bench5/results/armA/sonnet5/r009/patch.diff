+    def add_seed(
+        self, seed: Thing | SeedDict | SeedSubjectString | AnnotatedSeedDict
+    ) -> bool:
+        """
+        Adds a new seed to this list.
+
+        seed can be:
+            - a `Thing`: author, edition or work object
+            - a key dict: {"key": "..."} for author, edition or work objects
+            - a string: for a subject
+            - an annotated seed dict: {"thing": {"key": "..."}, "notes": "..."}
+        """
+        seed = self._to_seed(seed)
+
+        if self._index_of_seed(seed.key) >= 0:
+            return False
+        else:
+            self.seeds = self.seeds or []
+            self.seeds.append(seed.to_db())
+            return True
+
+    def remove_seed(
+        self, seed: Thing | SeedDict | SeedSubjectString | AnnotatedSeedDict
+    ) -> bool:
+        """Removes a seed for the list, matching on key only (notes ignored)."""
+        seed = self._to_seed(seed)
+
+        if (index := self._index_of_seed(seed.key)) >= 0:
+            self.seeds.pop(index)
+            return True
+        else:
+            return False
+
+    def _to_seed(
+        self, seed: 'Seed | Thing | SeedDict | SeedSubjectString | AnnotatedSeedDict'
+    ) -> 'Seed':
+        if isinstance(seed, Seed):
+            return seed
+        if isinstance(seed, (str, dict)):
+            return Seed.from_json(self, seed)
+        return Seed(self, seed)
+
+    def _resolve_seed_thing(self, seed: Thing | SeedSubjectString) -> Thing | SeedSubjectString:
+        """
+        Returns the key-bearing `Thing` (or subject string) a raw `seeds`
+        entry refers to, unwrapping annotated seeds.
+        """
+        if isinstance(seed, Thing) and seed.key is None:
+            thing_ref = (seed._data or {}).get('thing')
+            if isinstance(thing_ref, Thing):
+                return thing_ref
+            if isinstance(thing_ref, dict):
+                return Thing(self._site, thing_ref.get('key'), None)
+        return seed
+
+    def _index_of_seed(self, key: ThingKey | SeedSubjectString) -> int:
+        for i, s in enumerate(self._get_seed_strings()):
+            if s == key:
+                return i
+        return -1
+
+    def __repr__(self):
+        return f"<List: {self.key} ({self.name!r})>"
+
+    def _get_seed_strings(self) -> list[SeedSubjectString | ThingKey]:
+        return [Seed(self, seed).key for seed in self.seeds]
