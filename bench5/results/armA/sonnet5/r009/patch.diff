+@public
+def get_seed_edit_dict(
+    seed: Thing | SeedDict | AnnotatedSeedDict | SeedSubjectString,
+) -> dict:
+    """
+    Normalizes a raw seed -- as stored in `List.seeds` (a `Thing`, possibly
+    an annotated-seed wrapper with `key is None`, or a subject string) or in
+    `ListRecord.seeds` (a JSON seed dict or subject string) -- into a
+    template-friendly `{"key": ..., "notes": ...}` dict for the list-edit
+    form. Kept out of the (sandboxed) template itself since annotated seeds
+    require touching `Thing._data`.
+    """
+    if isinstance(seed, str):
+        return {'key': '/subjects/' + seed, 'notes': ''}
+    if isinstance(seed, dict):
+        if 'thing' in seed:
+            return {'key': seed['thing'].get('key', ''), 'notes': seed.get('notes') or ''}
+        return {'key': seed.get('key', ''), 'notes': ''}
+    if seed.key is None:
+        # An annotated-seed wrapper: {"thing": {"key": "..."}, "notes": "..."}
+        data = seed._data or {}
+        thing = data.get('thing') or {}
+        thing_key = thing.key if isinstance(thing, Thing) else thing.get('key', '')
+        return {'key': thing_key, 'notes': data.get('notes') or ''}
+    return {'key': seed.key, 'notes': ''}
+
+
