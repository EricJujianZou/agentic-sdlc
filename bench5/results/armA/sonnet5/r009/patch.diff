+        # dict input: a plain {"key": "..."}, a flat form-submitted
+        # {"key": "...", "notes": "..."}, or an AnnotatedSeedDict
+        # {"thing": {"key": "..."}, "notes": "..."}.
+        key = seed['thing']['key'] if 'thing' in seed else seed['key']
+        notes = seed.get('notes') or ''
+
+        if key.startswith('/subjects/'):
+            # Subjects can't carry notes.
+            return subject_key_to_seed(key)
+        if not notes:
+            return {'key': key}
+        return {'thing': {'key': key}, 'notes': notes}
