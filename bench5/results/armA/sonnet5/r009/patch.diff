+    @staticmethod
+    def from_json(
+        list: 'List',
+        seed_json: SeedSubjectString | ThingReferenceDict | AnnotatedSeedDict,
+    ) -> 'Seed':
+        """
+        Parses a JSON-compatible seed representation (as accepted by the
+        lists APIs / edit form) into a `Seed`, supporting legacy
+        (unannotated) and annotated formats.
+        """
+        if isinstance(seed_json, str):
+            return Seed(list, seed_json)
+
+        if 'thing' in seed_json:
+            thing_ref = seed_json['thing']
+            seed = Seed(list, Thing(list._site, thing_ref['key'], None))
+            seed.notes = seed_json.get('notes') or None
+            return seed
+
+        return Seed(list, Thing(list._site, seed_json['key'], None))
+
+    def to_db(self) -> Thing | SeedSubjectString:
+        """Returns the DB-storable representation of this seed."""
+        if isinstance(self.value, str):
+            return self.value
+        if self.notes:
+            return Thing(
+                self._list._site,
+                None,
+                {'thing': {'key': self.key}, 'notes': self.notes},
+            )
+        return self.value
+
+    def to_json(self) -> SeedSubjectString | ThingReferenceDict | AnnotatedSeedDict:
+        """Returns the JSON-compatible representation of this seed, as used
