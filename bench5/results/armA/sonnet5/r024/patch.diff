+// Registration represents an ongoing Touch ID registration with an
+// already-created Secure Enclave key.
+// The struct provides methods to explicitly confirm or rollback the
+// registration.
+//
+// Registration is used to avoid orphaned Secure Enclave credentials: the
+// Secure Enclave key is created before the caller knows whether the
+// server-side registration will succeed, so the caller must explicitly
+// Confirm (on success) or Rollback (on failure) the registration.
+type Registration struct {
+	// CCR is the credential creation response for the pending registration.
+	CCR *wanlib.CredentialCreationResponse
+
+	credentialID string
+	// done is set to 1 once Confirm or Rollback has run. Guards against
+	// duplicate/racing calls.
+	done int32
+}
+
+// Confirm confirms the Touch ID registration.
+// This may replace equivalent keys with the current registration at the
+// implementation's discretion.
+func (r *Registration) Confirm() error {
+	atomic.StoreInt32(&r.done, 1)
+	return nil
+}
+
+// Rollback rolls back the Touch ID registration, deleting the Secure Enclave
+// key that was created.
+// This is useful when server-side registration fails.
+func (r *Registration) Rollback() error {
+	if !atomic.CompareAndSwapInt32(&r.done, 0, 1) {
+		return nil // already confirmed or rolled back
+	}
+	return trace.Wrap(native.DeleteNonInteractive(r.credentialID))
+}
