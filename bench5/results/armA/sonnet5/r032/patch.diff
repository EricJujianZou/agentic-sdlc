+import { ComponentType } from 'react';
+
+export type HOC<T> = (Component: ComponentType<T>) => ComponentType<T>;
+
+/**
+ * Composes multiple Higher-Order Components into a single one, applying them
+ * right-to-left (the last HOC in the list wraps the component first).
+ */
+export const applyHOCs =
+    <T>(...hocs: HOC<T>[]) =>
+    (Component: ComponentType<T>): ComponentType<T> =>
+        hocs.reduceRight((WrappedComponent, hoc) => hoc(WrappedComponent), Component);
+
+const Children = ({ children }: any) => children ?? null;
+
+/**
+ * Builds a wrapper component suitable for the `wrapper` option of
+ * `renderHook`, by applying the given HOCs around a component that simply
+ * renders its children.
+ */
+export const hookWrapper = <T>(...hocs: HOC<T>[]) => applyHOCs<T>(...hocs)(Children as ComponentType<T>);
