 func overrideServerData(scanResult *models.ScanResult, trivyResult *report.Result) {
 	scanResult.Family = trivyResult.Type
 	scanResult.ServerName = trivyResult.Target
@@ -178,3 +220,16 @@ func overrideServerData(scanResult *models.ScanResult, trivyResult *report.Resul
 	scanResult.ScannedBy = "trivy"
 	scanResult.ScannedVia = "trivy"
 }
+
+// overridePseudoServerData fills in the ScanResult's server data for a Trivy
+// report that only contains library findings (no OS information).
+func overridePseudoServerData(scanResult *models.ScanResult, trivyResult *report.Result) {
+	scanResult.Family = constant.ServerTypePseudo
+	if scanResult.ServerName == "" {
+		scanResult.ServerName = "library scan by trivy"
+	}
+	if scanResult.Optional == nil {
+		scanResult.Optional = map[string]interface{}{}
+	}
+	scanResult.Optional["trivy-target"] = trivyResult.Target
+}
