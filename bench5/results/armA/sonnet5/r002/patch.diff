+// IsTrivySupportedLib :
+func IsTrivySupportedLib(libType string) bool {
+	supportedLibs := []string{
+		fanalTypes.Bundler,
+		fanalTypes.Cargo,
+		fanalTypes.Composer,
+		fanalTypes.Npm,
+		fanalTypes.NuGet,
+		fanalTypes.Pipenv,
+		fanalTypes.Poetry,
+		fanalTypes.Yarn,
+		fanalTypes.Jar,
+		fanalTypes.GoBinary,
+		fanalTypes.GoMod,
+	}
+	for _, supportedLib := range supportedLibs {
+		if libType == supportedLib {
+			return true
+		}
+	}
+	return false
+}
