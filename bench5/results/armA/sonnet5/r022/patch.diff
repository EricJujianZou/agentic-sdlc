+// setJSON marshals value as JSON and stores it in the cache under key.
+func setJSON[T any](ctx context.Context, s *Store, key string, value T) {
+	s.set(ctx, key, value)
+}
+
+// getJSON attempts to retrieve and unmarshal a JSON value from the cache under key.
+func getJSON[T any](ctx context.Context, s *Store, key string) (T, bool) {
+	var value T
+	cacheHit := s.get(ctx, key, &value)
+	return value, cacheHit
+}
+
+// setProtobuf marshals value as a protocol buffer and stores it in the cache under key.
+func setProtobuf(ctx context.Context, s *Store, key string, value proto.Message) {
+	cachePayload, err := proto.Marshal(value)
+	if err != nil {
+		s.logger.Error("marshalling for storage cache", zap.Error(err))
+		return
+	}
+
+	if err := s.cacher.Set(ctx, key, cachePayload); err != nil {
+		s.logger.Error("setting in storage cache", zap.Error(err))
+	}
+}
+
+// getProtobuf attempts to retrieve and unmarshal a protocol buffer value from the cache under key
+// into value.
+func getProtobuf[T proto.Message](ctx context.Context, s *Store, key string, value T) bool {
+	cachePayload, cacheHit, err := s.cacher.Get(ctx, key)
+	if err != nil {
+		s.logger.Error("getting from storage cache", zap.Error(err))
+		return false
+	} else if !cacheHit {
+		return false
+	}
+
+	if err := proto.Unmarshal(cachePayload, value); err != nil {
+		s.logger.Error("unmarshalling from storage cache", zap.Error(err))
+		return false
+	}
+
+	return true
+}
+
+func (s *Store) deleteFlagCache(ctx context.Context, namespaceKey, flagKey string) {
+	cacheKey := fmt.Sprintf(flagCacheKeyFmt, namespaceKey, flagKey)
+	if err := s.cacher.Delete(ctx, cacheKey); err != nil {
+		s.logger.Error("deleting from storage cache", zap.Error(err))
+	}
+}
+
+func (s *Store) GetFlag(ctx context.Context, r storage.ResourceRequest) (*flipt.Flag, error) {
+	cacheKey := fmt.Sprintf(flagCacheKeyFmt, r.Namespace(), r.Key)
+
+	flag := &flipt.Flag{}
+	if getProtobuf(ctx, s, cacheKey, flag) {
+		return flag, nil
+	}
+
+	flag, err := s.Store.GetFlag(ctx, r)
+	if err != nil {
+		return nil, err
+	}
+
+	setProtobuf(ctx, s, cacheKey, flag)
+	return flag, nil
+}
+
+func (s *Store) UpdateFlag(ctx context.Context, r *flipt.UpdateFlagRequest) (*flipt.Flag, error) {
+	flag, err := s.Store.UpdateFlag(ctx, r)
+	if err != nil {
+		return nil, err
+	}
+
+	s.deleteFlagCache(ctx, r.GetNamespaceKey(), r.GetKey())
+	return flag, nil
+}
