new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/api/main/OperationProgressTracker.ts
@@ -0,0 +1,37 @@
+import stream from "mithril/stream"
+
+export type OperationId = number
+
+export type ExposedOperationProgressTracker = Pick<OperationProgressTracker, "onProgress">
+
+/**
+ * Multiplexer for tracking the progress of individual async operations (e.g. a calendar import),
+ * as opposed to ProgressTracker which tracks the aggregate progress of all ongoing work.
+ * Operations are registered on the main thread and can be updated from anywhere (e.g. the worker)
+ * via their OperationId.
+ */
+export class OperationProgressTracker {
+	private operations: Map<OperationId, stream<number>> = new Map()
+	private idCounter: OperationId = 0
+
+	/**
+	 * Register a new operation to be tracked, so that its progress can be displayed.
+	 * Returns an id as a handle (useful for making calls from the worker), a progress stream to
+	 * observe (0 to 100), and a done() callback to unregister the operation once it is finished.
+	 */
+	registerOperation(): { id: OperationId; progress: stream<number>; done: () => unknown } {
+		const id = this.idCounter++
+		const progress = stream<number>(0)
+		this.operations.set(id, progress)
+		return {
+			id,
+			progress,
+			done: () => this.operations.delete(id),
+		}
+	}
+
+	/** async wrapper for remote */
+	async onProgress(operation: OperationId, progressValue: number): Promise<void> {
+		this.operations.get(operation)?.(progressValue)
+	}
+}
