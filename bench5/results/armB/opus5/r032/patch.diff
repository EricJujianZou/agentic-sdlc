@@ -0,0 +1,23 @@
+import { ComponentType, Fragment, ReactNode, createElement } from 'react';
+
+export type HOC<T = any> = (Component: ComponentType<T>) => ComponentType<T>;
+
+export type WrapperComponent<T = any> = ComponentType<T & { children?: ReactNode }>;
+
+/**
+ * Composes the given HOCs into a single one. The first HOC of the list ends up
+ * being the innermost wrapper of the returned component.
+ */
+export const applyHOCs =
+    <T>(...hocs: HOC<T>[]) =>
+    (Component: ComponentType<T>): ComponentType<T> =>
+        hocs.reduce((WrappedComponent, hoc) => hoc(WrappedComponent), Component);
+
+/**
+ * Builds a wrapper suitable for the `wrapper` option of renderHook()
+ */
+export const hookWrapper = <T>(...hocs: HOC<T>[]): WrapperComponent<T> => {
+    const Children = ({ children }: { children?: ReactNode }) => createElement(Fragment, null, children);
+
+    return applyHOCs<T>(...hocs)(Children as ComponentType<T>) as WrapperComponent<T>;
+};
