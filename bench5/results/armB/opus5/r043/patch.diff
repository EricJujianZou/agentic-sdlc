+import { useEffect, useState } from "react";
+
+import UIStore, { UI_EVENTS } from "../stores/UIStore";
+
+/**
+ * Hook to return the current window width, as tracked by the UIStore.
+ * The value is updated whenever the UIStore emits a resize event.
+ */
+export function useWindowWidth(): number {
+    const [width, setWidth] = useState(UIStore.instance.windowWidth);
+
+    useEffect(() => {
+        const handler = (): void => {
+            setWidth(UIStore.instance.windowWidth);
+        };
+
+        UIStore.instance.on(UI_EVENTS.Resize, handler);
+        return () => {
+            UIStore.instance.off(UI_EVENTS.Resize, handler);
+        };
+    }, []);
+
+    return width;
+}
