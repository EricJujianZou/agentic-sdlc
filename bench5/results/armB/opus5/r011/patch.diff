+// FormatKEVCveSummary returns a summary of KEV CVEs
+func (r ScanResult) FormatKEVCveSummary() string {
+	kevCnt := 0
+	for _, vuln := range r.ScannedCves {
+		if len(vuln.KEVs) > 0 {
+			kevCnt++
+		}
+	}
+	return fmt.Sprintf("%d KEVs", kevCnt)
+}
