diff --git a/changelogs/fragments/worker-detach-stdio.yml b/changelogs/fragments/worker-detach-stdio.yml
new file mode 100644
index 0000000..82d5b6e
--- /dev/null
+++ b/changelogs/fragments/worker-detach-stdio.yml
@@ -0,0 +1,6 @@
+minor_changes:
+  - worker - Worker processes are now detached from the inherited stdin/stdout/stderr
+    file descriptors and run in their own process group, so they can no longer write
+    directly to the terminal. All output is routed through ``Display``.
+  - connection plugins - ``new_stdin`` is no longer passed to connections; use
+    ``display.prompt_until`` instead.
