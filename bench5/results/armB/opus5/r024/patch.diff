+// Registration represents an ongoing registration, with an already-created
+// Secure Enclave key.
+// Callers must explicitly issue Confirm or Rollback to finish the process.
+type Registration struct {
+	CCR *wanlib.CredentialCreationResponse
+
+	credentialID string
+
+	// done is atomically set to 1 after either Rollback or Confirm are called.
+	done int32
+}
+
+// Confirm confirms the registration.
+// Keys are not deleted after confirmation and the registration is considered
+// finished.
+func (r *Registration) Confirm() error {
+	// Set r.done to disallow rollbacks after confirmation.
+	atomic.StoreInt32(&r.done, 1)
+	return nil
+}
+
+// Rollback rolls back the registration, deleting the Secure Enclave key as a
+// result. Rollback is a no-op after Confirm or a previous successful Rollback.
+func (r *Registration) Rollback() error {
+	if !atomic.CompareAndSwapInt32(&r.done, 0, 1) {
+		return nil
+	}
+
+	// Delete the newly-created credential.
+	return trace.Wrap(native.DeleteNonInteractive(r.credentialID))
+}
