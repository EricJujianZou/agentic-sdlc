+/**
+ * "All Sent" is a linked counterpart of "Sent" (it can even be hidden) and must always stay
+ * immediately before it in the list. Whenever "Sent" gets repositioned, re-insert "All Sent"
+ * right before its new position without touching the relative order of any other item.
+ */
+const linkAllSentToSent = (collection: SystemFolder[], sentDisplay?: SYSTEM_FOLDER_SECTION): SystemFolder[] => {
+    const allSentIndex = collection.findIndex((item) => item.labelID === MAILBOX_LABEL_IDS.ALL_SENT);
+    const sentIndex = collection.findIndex((item) => item.labelID === MAILBOX_LABEL_IDS.SENT);
+
+    if (allSentIndex === -1 || sentIndex === -1) {
+        return collection;
+    }
+
+    const allSentItem = cloneItem(collection[allSentIndex]);
+    if (sentDisplay !== undefined) {
+        allSentItem.display = sentDisplay;
+    }
+
+    const withoutAllSent = collection.filter((_, index) => index !== allSentIndex);
+    const nextSentIndex = withoutAllSent.findIndex((item) => item.labelID === MAILBOX_LABEL_IDS.SENT);
+
+    withoutAllSent.splice(nextSentIndex, 0, allSentItem);
+
+    return withoutAllSent;
+};
+
+/**
+ * When "Sent" is the dragged item, keep "All Sent" linked to it (immediately preceding it) and
+ * recompute contiguous order values. No-op for any other dragged item.
+ */
+const applySentAllSentLink = (draggedID: MAILBOX_LABEL_IDS, items: SystemFolder[]): SystemFolder[] => {
+    if (draggedID !== MAILBOX_LABEL_IDS.SENT) {
+        return items;
+    }
+
+    const sentItem = items.find((item) => item.labelID === MAILBOX_LABEL_IDS.SENT);
+    const linkedItems = linkAllSentToSent(items, sentItem?.display);
+
+    return reorderItems(linkedItems);
+};
