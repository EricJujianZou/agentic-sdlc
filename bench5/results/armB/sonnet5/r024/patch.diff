+func TestRegistration_ConfirmRollback(t *testing.T) {
+	n := *touchid.Native
+	t.Cleanup(func() {
+		*touchid.Native = n
+	})
+
+	web, err := webauthn.New(&webauthn.Config{
+		RPDisplayName: "Teleport",
+		RPID:          "teleport",
+		RPOrigin:      "https://goteleport.com",
+	})
+	require.NoError(t, err)
+
+	webUser := &fakeUser{id: []byte{1, 2, 3, 4, 5}, name: "llama"}
+
+	register := func(t *testing.T, fn *fakeNative) *touchid.Registration {
+		*touchid.Native = fn
+		cc, _, err := web.BeginRegistration(webUser)
+		require.NoError(t, err)
+		reg, err := touchid.Register(web.Config.RPOrigin, (*wanlib.CredentialCreation)(cc))
+		require.NoError(t, err, "Register failed")
+		return reg
+	}
+
+	t.Run("rollback deletes credential", func(t *testing.T) {
+		fn := &fakeNative{}
+		reg := register(t, fn)
+		require.Len(t, fn.creds, 1, "credential should exist after Register")
+
+		require.NoError(t, reg.Rollback(), "Rollback failed")
+		require.Empty(t, fn.creds, "credential should be deleted after Rollback")
+
+		// Second Rollback call must be a no-op (no error, no second delete
+		// attempt, which would otherwise fail with ErrCredentialNotFound).
+		require.NoError(t, reg.Rollback(), "second Rollback should be a no-op")
+	})
+
+	t.Run("confirm then rollback does not delete", func(t *testing.T) {
+		fn := &fakeNative{}
+		reg := register(t, fn)
+		require.Len(t, fn.creds, 1, "credential should exist after Register")
+
+		require.NoError(t, reg.Confirm(), "Confirm failed")
+		require.NoError(t, reg.Rollback(), "Rollback after Confirm should be a no-op")
+		require.Len(t, fn.creds, 1, "credential must not be deleted once confirmed")
+	})
+
+	t.Run("confirm is idempotent", func(t *testing.T) {
+		fn := &fakeNative{}
+		reg := register(t, fn)
+
+		require.NoError(t, reg.Confirm())
+		require.NoError(t, reg.Confirm())
+		require.Len(t, fn.creds, 1)
+	})
+
+	t.Run("login fails after rollback", func(t *testing.T) {
+		loginUser := &fakeUser{id: []byte{6, 7, 8, 9, 10}, name: "alpaca"}
+		*touchid.Native = &fakeNative{}
+
+		cc, sessionData, err := web.BeginRegistration(loginUser)
+		require.NoError(t, err)
+		reg, err := touchid.Register(web.Config.RPOrigin, (*wanlib.CredentialCreation)(cc))
+		require.NoError(t, err, "Register failed")
+
+		body, err := json.Marshal(reg.CCR)
+		require.NoError(t, err)
+		parsedCCR, err := protocol.ParseCredentialCreationResponseBody(bytes.NewReader(body))
+		require.NoError(t, err, "ParseCredentialCreationResponseBody failed")
+		cred, err := web.CreateCredential(loginUser, *sessionData, parsedCCR)
+		require.NoError(t, err, "CreateCredential failed")
+		// Simulate a server-side record existing (e.g. from a previous,
+		// separate confirmed registration) while the local Secure Enclave key
+		// backing it is gone -- exactly what Rollback produces when called
+		// after the fact, or what happens if the key is otherwise removed.
+		loginUser.credentials = append(loginUser.credentials, *cred)
+
+		require.NoError(t, reg.Rollback(), "Rollback failed")
+
+		a, _, err := web.BeginLogin(loginUser)
+		require.NoError(t, err, "BeginLogin failed")
+		assertion := (*wanlib.CredentialAssertion)(a)
+		assertion.Response.AllowedCredentials = nil // aka passwordless
+
+		_, _, err = touchid.Login(web.Config.RPOrigin, "" /* user */, assertion)
+		require.ErrorIs(t, err, touchid.ErrCredentialNotFound, "Login should fail with ErrCredentialNotFound after rollback")
+	})
+}
