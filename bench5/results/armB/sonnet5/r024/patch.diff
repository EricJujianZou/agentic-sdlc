+// DeleteNonInteractive deletes a Secure Enclave credential without requiring
+// user interaction (ie, no biometric/LAContext prompt).
+// Primarily used to rollback failed registrations.
+func (touchIDImpl) DeleteNonInteractive(credentialID string) error {
+	idC := C.CString(credentialID)
+	defer C.free(unsafe.Pointer(idC))
+
+	switch res := C.DeleteNonInteractiveCredential(idC); res {
+	case 0: // aka success
+		return nil
+	case errSecItemNotFound:
+		return ErrCredentialNotFound
+	default:
+		return fmt.Errorf("delete credential failed: OSStatus %d", res)
+	}
+}
