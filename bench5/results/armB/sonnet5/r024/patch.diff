+// Registration represents an ongoing Touch ID registration, with an
+// already-created Secure Enclave key.
+// It provides the means to explicitly confirm or rollback the registration,
+// so orphaned Secure Enclave credentials aren't left behind if a subsequent
+// step (such as server-side registration) fails.
+//
+// The zero value of Registration is not valid, it must be created by
+// Register.
+type Registration struct {
+	// CCR is the credential creation response for the registration.
+	CCR *wanlib.CredentialCreationResponse
+
+	// credentialID is the Secure Enclave credential identifier.
+	credentialID string
+
+	// done is used to guarantee that only one of Confirm or Rollback take
+	// effect, and only the first call between the two does anything.
+	// Manipulated atomically.
+	done int32
+}
+
+// Confirm confirms a Touch ID registration.
+// Marks the registration as finalized; a subsequent call to Rollback becomes
+// a no-op.
+// It is idempotent and safe for concurrent use.
+func (r *Registration) Confirm() error {
+	if !atomic.CompareAndSwapInt32(&r.done, 0, 1) {
+		return nil // Already finalized by a previous Confirm/Rollback call.
+	}
+	return nil
+}
+
+// Rollback rolls back a Touch ID registration, deleting the Secure Enclave
+// key created for it.
+// It is idempotent and safe for concurrent use: only the first call, be it
+// to Confirm or Rollback, has any effect. Subsequent calls are no-ops that
+// return nil.
+func (r *Registration) Rollback() error {
+	if !atomic.CompareAndSwapInt32(&r.done, 0, 1) {
+		return nil // Already finalized by a previous Confirm/Rollback call.
+	}
+	return trace.Wrap(native.DeleteNonInteractive(r.credentialID))
+}
