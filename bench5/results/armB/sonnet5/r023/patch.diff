diff --git a/src/api/main/OperationProgressTracker.ts b/src/api/main/OperationProgressTracker.ts
new file mode 100644
index 0000000..e64f8e8
--- /dev/null
+++ b/src/api/main/OperationProgressTracker.ts
@@ -0,0 +1,41 @@
+import stream from "mithril/stream"
+import Stream from "mithril/stream"
+
+export type OperationId = number
+
+export type ExposedOperationProgressTracker = Pick<OperationProgressTracker, "onProgress">
+
+/**
+ * Multiplexer that lets several concurrent async operations (e.g. concurrent calendar imports) each get
+ * their own progress stream, instead of sharing the single generic progress channel from ProgressTracker.
+ *
+ * Register an operation to get a handle with a dedicated progress stream, forward progress updates for
+ * that operation via {@link onProgress} (this is what gets exposed to the worker), and call the returned
+ * {@code done} function once the operation is finished to stop tracking it.
+ */
+export class OperationProgressTracker {
+	private readonly operations: Map<OperationId, Stream<number>> = new Map()
+	private idCounter: OperationId = 0
+
+	/**
+	 * Register a new operation to be tracked.
+	 * @returns an id to identify the operation (e.g. when reporting progress from the worker), a stream
+	 * that will emit the progress of the operation (a number between 0 and 100) and a done callback that
+	 * must be invoked once the operation has finished (successfully or not) to stop tracking it.
+	 */
+	registerOperation(): { id: OperationId; progress: Stream<number>; done: () => unknown } {
+		const id = this.idCounter++
+		const progress = stream<number>(0)
+		this.operations.set(id, progress)
+		return {
+			id,
+			progress,
+			done: () => this.operations.delete(id),
+		}
+	}
+
+	/** async wrapper for remote (called from the worker to report progress for a specific operation) */
+	async onProgress(operation: OperationId, progressValue: number): Promise<void> {
+		this.operations.get(operation)?.(progressValue)
+	}
+}
