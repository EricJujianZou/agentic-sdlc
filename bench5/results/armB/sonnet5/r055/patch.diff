+    describe("textForMemberEvent()", () => {
+        const userA = { userId: "@a:example.com", name: "Alice" } as RoomMember;
+
+        const mockMembershipEvent = (
+            content: Record<string, unknown>,
+            prevContent: Record<string, unknown>,
+        ): MatrixEvent => {
+            const event = new MatrixEvent({
+                type: EventType.RoomMember,
+                sender: userA.userId,
+                state_key: userA.userId,
+                content,
+                prev_content: prevContent,
+            });
+            event.sender = userA;
+            event.target = userA;
+            return event;
+        };
+
+        it("shows a single combined message when display name and profile picture change together", () => {
+            const event = mockMembershipEvent(
+                { membership: "join", displayname: "Alice B", avatar_url: "mxc://example.com/new" },
+                { membership: "join", displayname: "Alice", avatar_url: "mxc://example.com/old" },
+            );
+
+            expect(textForEvent(event)).toEqual("Alice changed their display name and profile picture");
+        });
+
+        it("still shows the display name only message when the profile picture is unchanged", () => {
+            const event = mockMembershipEvent(
+                { membership: "join", displayname: "Alice B", avatar_url: "mxc://example.com/same" },
+                { membership: "join", displayname: "Alice", avatar_url: "mxc://example.com/same" },
+            );
+
+            expect(textForEvent(event)).toEqual("Alice changed their display name to Alice B");
+        });
+
+        it("still shows the profile picture only message when the display name is unchanged", () => {
+            const event = mockMembershipEvent(
+                { membership: "join", displayname: "Alice", avatar_url: "mxc://example.com/new" },
+                { membership: "join", displayname: "Alice", avatar_url: "mxc://example.com/old" },
+            );
+
+            expect(textForEvent(event)).toEqual("Alice changed their profile picture");
+        });
+    });
+
