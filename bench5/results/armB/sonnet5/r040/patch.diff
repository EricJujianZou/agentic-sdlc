+	module.sortedSetIncrByBulk = async function (data) {
+		if (!Array.isArray(data) || !data.length) {
+			return [];
+		}
+
+		// batches the zincrby calls in a single multi/exec transaction, commands within
+		// a multi run sequentially on the server, so multiple increments to the same
+		// key/member accumulate correctly
+		const multi = module.client.multi();
+		data.forEach((item) => {
+			multi.zincrby(item[0], item[1], item[2]);
+		});
+		const results = await helpers.execBatch(multi);
+		return results.map(score => parseFloat(score));
+	};
+
 	module.getSortedSetRangeByLex = async function (key, min, max, start, count) {
 		return await sortedSetLex('zrangebylex', false, key, min, max, start, count);
 	};
