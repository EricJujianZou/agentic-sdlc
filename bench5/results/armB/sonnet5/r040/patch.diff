+	module.sortedSetIncrByBulk = async function (data) {
+		if (!Array.isArray(data) || !data.length) {
+			return [];
+		}
+
+		// executes each increment concurrently using the existing sortedSetIncrBy logic,
+		// each of which is a single atomic "INSERT ... ON CONFLICT DO UPDATE" statement,
+		// so increments to the same key/value pair are accumulated correctly even
+		// though they run concurrently
+		return await Promise.all(data.map(
+			item => module.sortedSetIncrBy(item[0], item[1], item[2])
+		));
+	};
+
 	module.getSortedSetRangeByLex = async function (key, min, max, start, count) {
 		return await sortedSetLex(key, min, max, 1, start, count);
 	};
diff --git a/src/database/redis/sorted.js b/src/database/redis/sorted.js
index cc23c4a957..b40e21559b 100644
--- a/src/database/redis/sorted.js
+++ b/src/database/redis/sorted.js
@@ -240,6 +240,22 @@ module.exports = function (module) {
 		return parseFloat(newValue);
