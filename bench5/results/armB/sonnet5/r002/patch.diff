+// IsTrivySupportedLib :
+func IsTrivySupportedLib(libType string) bool {
+	supportedLibs := []string{
+		fanalLib.Bundler,
+		fanalLib.Cargo,
+		fanalLib.Composer,
+		fanalLib.Npm,
+		fanalLib.NuGet,
+		fanalLib.Pipenv,
+		fanalLib.Poetry,
+		fanalLib.Yarn,
+		fanalLib.Jar,
+		fanalLib.GoBinary,
+		fanalLib.GoMod,
+	}
+	for _, supportedLib := range supportedLibs {
+		if libType == supportedLib {
+			return true
+		}
+	}
+	return false
+}
