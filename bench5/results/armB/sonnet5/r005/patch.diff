diff --git a/lib/ansible/playbook/block.py b/lib/ansible/playbook/block.py
index 45f7a38a77..e1b356fd4d 100644
--- a/lib/ansible/playbook/block.py
+++ b/lib/ansible/playbook/block.py
@@ -390,6 +390,25 @@ class Block(Base, Conditional, CollectionSearch, Taggable):
     def has_tasks(self):
         return len(self.block) > 0 or len(self.rescue) > 0 or len(self.always) > 0
 
+    def get_tasks(self):
+        '''
+        Returns a flattened, ordered list of every Task contained in this
+        block's `block`, `rescue`, and `always` sections, recursively
+        expanding any nested Block instances so callers get a uniform,
+        block-free view of the tasks to be run.
+        '''
+
+        def _flatten(task_list):
+            tasks = []
+            for task in task_list:
+                if isinstance(task, Block):
+                    tasks.extend(task.get_tasks())
+                else:
+                    tasks.append(task)
+            return tasks
+
+        return _flatten(self.block) + _flatten(self.rescue) + _flatten(self.always)
+
     def get_include_params(self):
         if self._parent:
             return self._parent.get_include_params()
