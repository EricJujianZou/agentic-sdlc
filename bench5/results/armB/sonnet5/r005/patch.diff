+    def _force_handler_flush(self, section_blocks, flush_block):
+        '''
+        Wraps the given list of top level Blocks (a pre_tasks/tasks/post_tasks
+        section) in a single Block whose `always` runs a handler flush, so
+        that when force_handlers is enabled, notified handlers are still run
+        even if a task in the section fails. If the section is empty, an
+        implicit `meta: noop` Task is inserted so the wrapper block still has
+        something in `block` (required for `always` to be usable) and a
+        flush point is still guaranteed.
+        '''
+
+        wrapper_block = Block(play=self)
+        wrapper_block._loader = self._loader
+        wrapper_block._variable_manager = self._variable_manager
+
+        if section_blocks:
+            wrapper_block.block = section_blocks
+        else:
+            noop_task = Task.load(
+                data={'meta': 'noop'},
+                block=wrapper_block,
+                variable_manager=self._variable_manager,
+                loader=self._loader,
+            )
+            noop_task.implicit = True
+            wrapper_block.block = [noop_task]
+
+        wrapper_block.always = [flush_block]
+
+        return [wrapper_block]
+
     def get_vars(self):
         return self.vars.copy()
 
