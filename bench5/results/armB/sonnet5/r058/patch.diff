+def _is_child_path(path, resolved_path_root, link_name=None):
+    """Check whether the given path resolves to a location that is a child of ``resolved_path_root``.
+
+    This is used both when building a collection (to decide whether a symlink's target lives inside the
+    collection tree) and when extracting one (to decide whether a symlink member in the tar can be safely
+    recreated as a symlink on disk).
+
+    :param path: The path to validate. When ``link_name`` is provided, ``path`` is treated as the (possibly
+        relative) target of the symlink named by ``link_name`` and is resolved relative to the directory that
+        contains ``link_name`` before being checked.
+    :param resolved_path_root: The trusted root directory that ``path`` must resolve inside of.
+    :param link_name: The path (on disk, or the intended destination path) of the symlink whose target is
+        being checked. Only used to resolve a relative ``path``.
+    """
+    b_path = to_bytes(path, errors='surrogate_or_strict')
+
+    if link_name and not os.path.isabs(b_path):
+        b_link_name = to_bytes(link_name, errors='surrogate_or_strict')
+        b_path = os.path.join(os.path.dirname(b_link_name), b_path)
+
+    b_resolved_path_root = to_bytes(resolved_path_root, errors='surrogate_or_strict')
+
+    b_norm_path = os.path.normpath(os.path.abspath(b_path))
+    b_norm_root = os.path.normpath(os.path.abspath(b_resolved_path_root))
+
+    return b_norm_path == b_norm_root or b_norm_path.startswith(b_norm_root + to_bytes(os.path.sep))
+
+
