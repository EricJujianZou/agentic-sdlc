+def _extract_tar_dir(tar, dirname, b_dest):
+    """Extract a directory ftype entry from the collection tar, which may actually be a symlink member."""
+    n_dirname = to_native(dirname, errors='surrogate_or_strict')
+    try:
+        tar_member = tar.getmember(n_dirname)
+    except KeyError:
+        raise AnsibleError("Collection tar at '%s' does not contain the expected directory '%s'." % (
+            to_native(tar.name),
+            n_dirname))
+
+    b_dest_dir_path = _get_tar_dest_path(dirname, b_dest)
+    b_parent_dir = os.path.dirname(b_dest_dir_path)
+    if not os.path.exists(b_parent_dir):
+        os.makedirs(b_parent_dir, mode=0o0755)
+
+    if tar_member.issym():
+        if _extract_tar_symlink(tar_member, b_dest_dir_path, b_dest):
+            return
+
+        # Target resolves outside of the destination - fall back to creating a regular directory.
+        display.warning("Creating an empty directory for '%s' instead of a symlink outside the collection "
+                        "directory" % n_dirname)
+
+    if not os.path.exists(b_dest_dir_path):
+        os.makedirs(b_dest_dir_path, mode=0o0755)
