@@ -0,0 +1,25 @@
+import { ComponentType, PropsWithChildren, ReactNode } from 'react';
+
+export type HOC<T> = (Component: ComponentType<T>) => ComponentType<T>;
+
+export type WrapperComponent<T> = ComponentType<PropsWithChildren<T>>;
+
+/**
+ * Applies multiple Higher-Order Components to a React component by reducing them into
+ * a single wrapped component. HOCs are applied in the order they are given, so the last
+ * HOC in the list ends up wrapping the outermost layer.
+ */
+export const applyHOCs =
+    <T>(...hocs: HOC<T>[]) =>
+    (Component: ComponentType<T>): ComponentType<T> =>
+        hocs.reduce((WrappedComponent, hoc) => hoc(WrappedComponent), Component);
+
+/**
+ * Creates a wrapper component for testing React hooks (e.g. with `renderHook`) by applying
+ * multiple HOCs around a pass-through component that simply renders its children.
+ */
+export const hookWrapper = <T extends { children?: ReactNode }>(...hocs: HOC<T>[]): WrapperComponent<T> => {
+    const PassThrough = ({ children }: PropsWithChildren<T>) => children as JSX.Element;
+
+    return applyHOCs(...hocs)(PassThrough as ComponentType<T>);
+};
