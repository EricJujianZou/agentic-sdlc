+    re.fullmatch(r'(.*\D|^)(0*)(\d+)(.*)', segment) would give for the
+    last (rightmost) digit run, or None if there's no number outside of
+    percent-encoded data.
+    """
+    masked = _mask_percent_encoded(segment)
+    matches = list(re.finditer(r'\d+', masked))
+    if not matches:
+        return None
