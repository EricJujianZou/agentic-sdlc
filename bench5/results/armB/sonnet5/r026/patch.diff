+def _mask_percent_encoded(segment):
+    """Blank out digits that are part of a percent-encoded triplet.
+
+    Returns a string the same length as `segment` where any digit that
+    belongs to a percent-encoded byte (e.g. the '3' and 'a' in '%3a') is
+    replaced by a non-digit placeholder, so such digits are never mistaken
+    for part of a number to increment/decrement. Everything else (length
+    and non-digit characters) is left untouched, so offsets found in the
+    masked string can be used to slice the original string byte-exact.
+    """
+    def _mask(match):
+        triplet = match.group(0)
+        return triplet[0] + re.sub(r'\d', 'x', triplet[1:])
+
+    return _ENCODED_TRIPLET_RE.sub(_mask, segment)
+
+
+def _find_last_number(segment):
+    """Find the last numeric sequence in a URL segment.
