@@ -130,6 +130,17 @@ class TaskQueueManager:
 
     def __init__(self, inventory, variable_manager, loader, passwords, stdout_callback=None, run_additional_callbacks=True, run_tree=False, forks=None):
 
+        # Prevent stdin/stdout/stderr from being inherited by child (worker) processes, so
+        # workers cannot read from or write directly to whatever terminal this process may be
+        # attached to; all worker output is routed over the display queue instead.
+        for stream in (sys.stdin, sys.stdout, sys.stderr):
+            try:
+                os.set_inheritable(stream.fileno(), False)
+            except (AttributeError, OSError, ValueError):
+                # stream may not have a real fd (eg it's been replaced/mocked), or the
+                # platform may not support changing fd inheritability; nothing we can do.
+                pass
+
         self._inventory = inventory
         self._variable_manager = variable_manager
         self._loader = loader
