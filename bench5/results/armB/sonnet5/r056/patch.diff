+// MakeTableWithTruncatedColumn creates a table whose column widths are
+// computed from the terminal size. Every column other than truncatedColumn
+// is given a maximum width proportional to the available terminal space,
+// while the column named truncatedColumn (matched against columnOrder by
+// header name) expands or shrinks to occupy whatever space remains,
+// truncating its content with an ellipsis when it doesn't fit.
+//
+// If the terminal size cannot be determined, a default width of 80 is used.
+//
+// If truncatedColumn does not match any entry in columnOrder, no column is
+// truncated and the table is built with all columns and data intact.
+//
+// columnOrder may contain empty strings, in which case the resulting table
+// is headless (see MakeHeadlessTable), same as with MakeTable.
+func MakeTableWithTruncatedColumn(columnOrder []string, rows [][]string, truncatedColumn string) Table {
+	width := getTerminalWidth()
+
+	truncatedColIndex := -1
+	for i, name := range columnOrder {
+		if name == truncatedColumn {
+			truncatedColIndex = i
+			break
+		}
+	}
+
+	otherCols := len(columnOrder)
+	if truncatedColIndex != -1 {
+		otherCols--
+	}
+	maxColWidth := 0
+	if truncatedColIndex != -1 && otherCols > 0 {
+		maxColWidth = (width - truncatedColumnMinSize) / otherCols
+	}
+
+	t := MakeTable(make([]string, 0))
+	columns := make([]Column, 0, len(columnOrder))
+	totalLen := 0
+
+	for i, colName := range columnOrder {
+		column := Column{
+			Title:         colName,
+			MaxCellLength: len(colName),
+		}
+		if i == truncatedColIndex {
+			// The truncated column's width is computed in the second pass,
+			// once the widths of all other columns are known.
+			columns = append(columns, column)
+			continue
+		}
+		for _, row := range rows {
+			if i >= len(row) {
+				continue
+			}
+			if len(row[i]) > column.MaxCellLength {
+				column.MaxCellLength = len(row[i])
+			}
+		}
+		if truncatedColIndex != -1 {
+			if maxColWidth > 0 && column.MaxCellLength > maxColWidth {
+				column.MaxCellLength = maxColWidth
+				totalLen += column.MaxCellLength + 4 // "... "
+			} else {
+				totalLen += column.MaxCellLength + 1 // column separator
+			}
+		}
+		columns = append(columns, column)
+	}
+
+	for i, column := range columns {
+		if i == truncatedColIndex {
+			remaining := width - totalLen - len("... ")
+			if remaining < 0 {
+				remaining = 0
+			}
+			column.MaxCellLength = remaining
+		}
+		t.AddColumn(column)
+	}
+
+	for _, row := range rows {
+		t.AddRow(row)
+	}
+	return t
+}
+
+// getTerminalWidth returns the width of the current terminal, or
+// defaultTableWidth if it cannot be determined.
+func getTerminalWidth() int {
+	width, _, err := term.GetSize(int(os.Stdin.Fd()))
+	if err != nil || width <= 0 {
+		return defaultTableWidth
+	}
+	return width
+}
