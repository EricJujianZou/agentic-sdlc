+func TestMakeTableWithTruncatedColumn(t *testing.T) {
+	longLabel := strings.Repeat("l", 100)
+	rows := [][]string{
+		{"server-1", longLabel},
+	}
+
+	table := MakeTableWithTruncatedColumn([]string{"Name", "Labels"}, rows, "Labels")
+	out := table.AsBuffer().String()
+	require.Contains(t, out, "server-1")
+	require.Contains(t, out, "...")
+	require.NotContains(t, out, longLabel)
+}
+
+func TestMakeTableWithTruncatedColumnNoMatch(t *testing.T) {
+	// When truncatedColumn doesn't match any header, no column should be
+	// truncated and no data should be lost.
+	longLabel := strings.Repeat("l", 100)
+	rows := [][]string{
+		{"server-1", longLabel},
+	}
+
+	table := MakeTableWithTruncatedColumn([]string{"Name", "Labels"}, rows, "DoesNotExist")
+	out := table.AsBuffer().String()
+	require.Contains(t, out, "server-1")
+	require.Contains(t, out, longLabel)
+	require.NotContains(t, out, "...")
+}
+
+func TestMakeTableWithTruncatedColumnHeadless(t *testing.T) {
+	rows := [][]string{
+		{"server-1", "role=admin"},
+	}
+
+	table := MakeTableWithTruncatedColumn([]string{"", ""}, rows, "")
+	require.True(t, table.IsHeadless())
+	out := table.AsBuffer().String()
+	require.Contains(t, out, "server-1")
+	require.Contains(t, out, "role=admin")
+}
