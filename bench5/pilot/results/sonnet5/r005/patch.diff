diff --git a/applications/calendar/src/app/containers/calendar/HolidaysCalendarsSpotlight.tsx b/applications/calendar/src/app/containers/calendar/HolidaysCalendarsSpotlight.tsx
new file mode 100644
index 0000000000..ac7aef4cd6
--- /dev/null
+++ b/applications/calendar/src/app/containers/calendar/HolidaysCalendarsSpotlight.tsx
@@ -0,0 +1,38 @@
+import { ReactElement } from 'react';
+
+import { c } from 'ttag';
+
+import { FeatureCode, Spotlight, useSpotlightOnFeature, useSpotlightShow, useWelcomeFlags } from '@proton/components';
+
+interface Props {
+    children: ReactElement;
+    canShow: boolean;
+}
+
+const HolidaysCalendarsSpotlight = ({ children, canShow }: Props) => {
+    const [welcomeFlags] = useWelcomeFlags();
+
+    const { show: showSpotlight, onDisplayed } = useSpotlightOnFeature(
+        FeatureCode.HolidaysCalendarsSpotlight,
+        !welcomeFlags.isWelcomeFlow && canShow
+    );
+    const shouldShowSpotlight = useSpotlightShow(showSpotlight);
+
+    return (
+        <Spotlight
+            originalPlacement="right"
+            show={shouldShowSpotlight}
+            onDisplayed={onDisplayed}
+            content={
+                <>
+                    <div className="text-bold text-lg m-auto">{c('Spotlight').t`Public holidays`}</div>
+                    {c('Spotlight').t`You can now add your country's public holidays calendar.`}
+                </>
+            }
+        >
+            {children}
+        </Spotlight>
+    );
+};
+
+export default HolidaysCalendarsSpotlight;
