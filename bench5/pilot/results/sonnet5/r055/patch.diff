+limitations under the License.
+*/
+
+import React, { useState } from 'react';
+
+import { _t } from '../../../../languageHandler';
+import AccessibleButton from '../../elements/AccessibleButton';
+import Field from '../../elements/Field';
+import Spinner from '../../elements/Spinner';
+import Heading from '../../typography/Heading';
+import { DeviceWithVerification } from './types';
+
+interface Props {
+    device: DeviceWithVerification;
+    saveDeviceName: (deviceId: string, deviceName: string) => Promise<void>;
+}
+
+const MAX_DEVICE_NAME_LENGTH = 100;
+
+export const DeviceDetailHeading: React.FC<Props> = ({ device, saveDeviceName }) => {
+    const [isEditing, setIsEditing] = useState(false);
+    const [isLoading, setIsLoading] = useState(false);
+    const [deviceName, setDeviceName] = useState(device.display_name ?? '');
+    const [error, setError] = useState<string>();
+
+    const onRename = (): void => {
+        setDeviceName(device.display_name ?? '');
+        setError(undefined);
+        setIsEditing(true);
+    };
+
+    const onCancel = (): void => {
+        setIsEditing(false);
+        setError(undefined);
+    };
+
+    const onSave = async (): Promise<void> => {
+        setError(undefined);
+        const previousName = device.display_name ?? '';
+        if (deviceName === previousName) {
+            setIsEditing(false);
+            return;
+        }
+        setIsLoading(true);
+        try {
+            await saveDeviceName(device.device_id, deviceName);
+            setIsLoading(false);
+            setIsEditing(false);
+        } catch (error) {
+            setError(error instanceof Error ? error.message : _t('Failed to set display name'));
+            setIsLoading(false);
+        }
+    };
+
+    if (isEditing) {
+        return <div className='mx_DeviceDetailHeading' data-testid='device-detail-heading'>
+            <form
+                className='mx_DeviceDetailHeading_editForm'
+                onSubmit={(event) => { event.preventDefault(); onSave(); }}
+                data-testid='device-detail-heading-edit-form'
+            >
+                <Field
+                    type='text'
+                    value={deviceName}
+                    onChange={(event) => setDeviceName(event.target.value)}
+                    label={_t('Session name')}
+                    maxLength={MAX_DEVICE_NAME_LENGTH}
+                    disabled={isLoading}
+                    autoComplete='off'
+                    autoFocus
+                    data-testid='device-rename-input'
+                />
+                <div className='mx_DeviceDetailHeading_editMessage'>
+                    { _t('Please be aware that session names are also visible to people you communicate with.') }
+                </div>
+                { error &&
+                    <div className='mx_DeviceDetailHeading_error' data-testid='device-rename-error'>
+                        { error }
+                    </div>
+                }
+                <div className='mx_DeviceDetailHeading_editButtons'>
+                    <AccessibleButton
+                        onClick={onSave}
+                        kind='primary'
+                        disabled={isLoading}
+                        data-testid='device-rename-save-cta'
+                    >
+                        { _t('Save') }
+                        { isLoading && <Spinner w={16} h={16} /> }
+                    </AccessibleButton>
+                    <AccessibleButton
+                        onClick={onCancel}
+                        kind='primary_outline'
+                        disabled={isLoading}
+                        data-testid='device-rename-cancel-cta'
+                    >
+                        { _t('Cancel') }
+                    </AccessibleButton>
+                </div>
+            </form>
+        </div>;
+    }
+
+    return <div className='mx_DeviceDetailHeading' data-testid='device-detail-heading'>
+        <Heading size='h3'>{ device.display_name ?? device.device_id }</Heading>
+        <AccessibleButton
+            kind='link_inline'
+            onClick={onRename}
+            data-testid='device-heading-rename-cta'
+        >
+            { _t('Rename') }
+        </AccessibleButton>
+    </div>;
+};
+
+export default DeviceDetailHeading;
