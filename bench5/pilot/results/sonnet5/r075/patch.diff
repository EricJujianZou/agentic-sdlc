+"""A very simplistic ELF parser.
+
+This is used to get the QtWebEngine/Chromium version out of
+libQt5WebEngineCore.so.5 on Linux, without needing to actually initialize
+QtWebEngine (which is slow and can only be done once per process).
+
+This is *not* a general purpose ELF parser - it only implements the bare
+minimum needed to find the ``.rodata`` section of an ELF file, from which we
+then extract the relevant version strings via a regex.
+"""
+
+import re
+import enum
+import mmap
+import struct
+import ctypes.util
+import pathlib
+import dataclasses
+from typing import IO
+
+
+class ParseError(Exception):
+
+    """Raised when parsing the ELF file failed."""
+
+
+class Bitness(enum.Enum):
+
+    """Whether the ELF file is 32- or 64-bit."""
+
+    x32 = enum.auto()
+    x64 = enum.auto()
+
+
+class Endianness(enum.Enum):
+
+    """The byte order used in the ELF file."""
+
+    little = enum.auto()
+    big = enum.auto()
+
+
+@dataclasses.dataclass
+class Ident:
+
+    """The ELF identification header (e_ident)."""
+
+    klass: Bitness
+    data: Endianness
+    version: int
+    osabi: int
+    abiversion: int
+
+    @classmethod
+    def parse(cls, fobj: IO[bytes]) -> 'Ident':
+        """Parse an ELF identification header from a file object."""
+        magic = fobj.read(4)
+        if magic != b'\x7fELF':
+            raise ParseError(f"Invalid magic: {magic!r}")
+
+        ei_class = fobj.read(1)
+        if ei_class == b'\x01':
+            klass = Bitness.x32
+        elif ei_class == b'\x02':
+            klass = Bitness.x64
+        else:
+            raise ParseError(f"Invalid class: {ei_class!r}")
+
+        ei_data = fobj.read(1)
+        if ei_data == b'\x01':
+            data = Endianness.little
+        elif ei_data == b'\x02':
+            data = Endianness.big
+        else:
+            raise ParseError(f"Invalid data: {ei_data!r}")
+
+        if data != Endianness.little:
+            # We only implement parsing for little endian files, as that's
+            # the only thing relevant on the platforms we run on.
+            raise ParseError(f"Unsupported endianness: {data}")
+
+        ei_version = fobj.read(1)
+        version = ei_version[0] if ei_version else -1
+        if version != 1:
+            raise ParseError(f"Invalid version: {version}")
+
+        ei_osabi = fobj.read(1)
+        if not ei_osabi:
+            raise ParseError("Missing osabi")
+        osabi = ei_osabi[0]
+
+        ei_abiversion = fobj.read(1)
+        if not ei_abiversion:
+            raise ParseError("Missing abiversion")
+        abiversion = ei_abiversion[0]
+
+        padding = fobj.read(7)
+        if len(padding) != 7:
+            raise ParseError("Truncated identification padding")
+
+        return cls(klass=klass, data=data, version=version,
+                    osabi=osabi, abiversion=abiversion)
+
+
+def _read_struct(fobj: IO[bytes], fmt: str) -> tuple:
+    """Read and unpack a struct with the given format from a file object."""
+    fmt = '<' + fmt
+    size = struct.calcsize(fmt)
+    data = fobj.read(size)
+    if len(data) != size:
+        raise ParseError(f"Truncated data while reading {fmt!r} "
+                          f"(expected {size} bytes, got {len(data)})")
+    try:
+        return struct.unpack(fmt, data)
+    except struct.error as e:
+        raise ParseError(f"Failed to unpack {fmt!r}: {e}")
+
+
+@dataclasses.dataclass
+class Header:
+
+    """The rest of the ELF header, following the identification bytes."""
+
+    e_type: int
+    e_machine: int
+    e_version: int
+    e_entry: int
+    e_phoff: int
+    e_shoff: int
+    e_flags: int
+    e_ehsize: int
+    e_phentsize: int
+    e_phnum: int
+    e_shentsize: int
+    e_shnum: int
+    e_shstrndx: int
+
+    @classmethod
+    def parse(cls, fobj: IO[bytes], bitness: Bitness) -> 'Header':
+        """Parse the ELF header (without e_ident) from a file object."""
+        if bitness == Bitness.x32:
+            fmt = 'HHIIIIIHHHHHH'
+        elif bitness == Bitness.x64:
+            fmt = 'HHIQQQIHHHHHH'
+        else:
+            raise ParseError(f"Unsupported bitness: {bitness}")
+
+        fields = _read_struct(fobj, fmt)
+        return cls(*fields)
+
+
+@dataclasses.dataclass
+class SectionHeader:
+
+    """A single ELF section header entry."""
+
+    sh_name: int
+    sh_type: int
+    sh_flags: int
+    sh_addr: int
+    sh_offset: int
+    sh_size: int
+    sh_link: int
+    sh_info: int
+    sh_addralign: int
+    sh_entsize: int
+
+    @classmethod
+    def parse(cls, fobj: IO[bytes], bitness: Bitness) -> 'SectionHeader':
+        """Parse a single section header from a file object."""
+        if bitness == Bitness.x32:
+            fmt = '10I'
+        elif bitness == Bitness.x64:
+            fmt = '2I4Q2I2Q'
+        else:
+            raise ParseError(f"Unsupported bitness: {bitness}")
+
+        fields = _read_struct(fobj, fmt)
+        return cls(*fields)
+
+
+@dataclasses.dataclass
+class Versions:
+
+    """Versions as extracted from an ELF file's .rodata section."""
+
+    webengine: str
+    chromium: str
+
+
+def get_rodata_header(f: IO[bytes]) -> SectionHeader:
+    """Find the .rodata section header in the given ELF file object."""
+    ident = Ident.parse(f)
+    header = Header.parse(f, ident.klass)
+
+    if header.e_shnum == 0 or header.e_shstrndx == 0:
+        raise ParseError("No section headers found")
+
+    f.seek(header.e_shoff)
+    section_headers = [
+        SectionHeader.parse(f, ident.klass) for _ in range(header.e_shnum)
+    ]
+
+    if header.e_shstrndx >= len(section_headers):
+        raise ParseError(
+            f"Invalid section header string table index: "
+            f"{header.e_shstrndx}")
+
+    shstrtab_header = section_headers[header.e_shstrndx]
+    f.seek(shstrtab_header.sh_offset)
+    shstrtab = f.read(shstrtab_header.sh_size)
+
+    for sh in section_headers:
+        end = shstrtab.find(b'\x00', sh.sh_name)
+        if end == -1:
+            raise ParseError("Unterminated section name")
+        try:
+            name = shstrtab[sh.sh_name:end].decode('ascii')
+        except UnicodeDecodeError as e:
+            raise ParseError(f"Failed to decode section name: {e}")
+
+        if name == '.rodata':
+            return sh
+
+    raise ParseError("No .rodata section found")
+
+
+_WEBENGINE_VERSION_RE = re.compile(rb'QtWebEngine/([0-9.]+)')
+_CHROMIUM_VERSION_RE = re.compile(rb'Chrome/([0-9.]+)')
+
+
+def _find_webenginecore() -> pathlib.Path:
+    """Try to find the libQt5WebEngineCore.so.5 library on disk."""
+    try:
+        import PyQt5
+    except ImportError as e:
+        raise ParseError(f"Could not import PyQt5: {e}")
+
+    pyqt_dir = pathlib.Path(PyQt5.__file__).resolve().parent
+    for subdir in ('Qt5', 'Qt'):
+        candidate = pyqt_dir / subdir / 'lib' / 'libQt5WebEngineCore.so.5'
+        if candidate.exists():
+            return candidate
+
+    found = ctypes.util.find_library('Qt5WebEngineCore')
+    if found is not None:
+        candidate = pathlib.Path(found)
+        if candidate.exists():
+            return candidate
+
+    raise ParseError("Could not find libQt5WebEngineCore.so.5")
+
+
+def parse_webenginecore() -> Versions:
+    """Find and parse libQt5WebEngineCore.so.5 to get its version info.
+
+    Raises ParseError if the library can't be found, isn't a valid ELF
+    file, doesn't have a .rodata section, or if the version strings can't
+    be found/decoded in that section.
+    """
+    path = _find_webenginecore()
+
+    try:
+        with path.open('rb') as f:
+            with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mapping:
+                section_header = get_rodata_header(mapping)
+                mapping.seek(section_header.sh_offset)
+                rodata = mapping.read(section_header.sh_size)
+    except OSError as e:
+        raise ParseError(f"Failed to read {path}: {e}")
+
+    webengine_match = _WEBENGINE_VERSION_RE.search(rodata)
+    chromium_match = _CHROMIUM_VERSION_RE.search(rodata)
+    if webengine_match is None or chromium_match is None:
+        raise ParseError(
+            f"Could not find version strings in .rodata section of {path}")
+
+    try:
+        webengine = webengine_match.group(1).decode('ascii')
+        chromium = chromium_match.group(1).decode('ascii')
+    except UnicodeDecodeError as e:
+        raise ParseError(f"Failed to decode version string: {e}")
+
+    return Versions(webengine=webengine, chromium=chromium)
