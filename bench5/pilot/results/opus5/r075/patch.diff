+import io
+import struct
+
+import pytest
+import hypothesis
+from hypothesis import strategies as hst
+
+from qutebrowser.misc import elf
+from qutebrowser.utils import utils
+
+
+@pytest.mark.parametrize('fmt, expected', [
+    (elf.Ident._FORMAT, 0x10),
+    (elf.Header._FORMATS[elf.Bitness.x64], 0x30),
+    (elf.Header._FORMATS[elf.Bitness.x32], 0x24),
+    (elf.SectionHeader._FORMATS[elf.Bitness.x64], 0x40),
+    (elf.SectionHeader._FORMATS[elf.Bitness.x32], 0x28),
+])
+def test_format_sizes(fmt, expected):
+    """Ensure the struct format sizes match the ELF spec."""
+    assert struct.calcsize(fmt) == expected
+
+
+@pytest.mark.skipif(not utils.is_linux, reason="Only works on Linux")
+def test_result(qapp, caplog):
+    """Test parsing the QtWebEngineCore library on this system."""
+    pytest.importorskip('PyQt5.QtWebEngineWidgets')
+
+    versions = elf.parse_webenginecore()
+    if versions is None:
+        pytest.skip("No QtWebEngineCore library found")
+
+    assert versions.webengine
+    assert versions.chromium
+
+
+@pytest.mark.parametrize('data, expected', [
+    (b'\x00QtWebEngine/5.15.2 Chrome/83.0.4103.122\x00',
+     elf.Versions(webengine='5.15.2', chromium='83.0.4103.122')),
+    (b'\x00QtWebEngine/5.14.0\x00\x00Chrome/77.0.3865.98\x00',
+     elf.Versions(webengine='5.14.0', chromium='77.0.3865.98')),
+])
+def test_find_versions(data, expected):
+    assert elf._find_versions(data) == expected
+
+
+@pytest.mark.parametrize('data', [
+    b'',
+    b'QtWebEngine/5.15.2',
+    b'Chrome/83.0.4103.122',
+])
+def test_find_versions_invalid(data):
+    with pytest.raises(elf.ParseError):
+        elf._find_versions(data)
+
+
+def test_invalid_magic():
+    with pytest.raises(elf.ParseError, match='Invalid magic'):
+        elf.get_rodata_header(io.BytesIO(b'\x7fELG' + b'\x02\x01' + b'\x00' * 100))
+
+
+def test_big_endian():
+    with pytest.raises(elf.ParseError, match='Big endian is unsupported'):
+        elf.get_rodata_header(io.BytesIO(b'\x7fELF' + b'\x02\x02' + b'\x00' * 100))
+
+
+@hypothesis.given(data=hst.binary())
+def test_hypothesis(data):
+    """Fuzz the ELF parser: only ParseError should ever be raised."""
+    fobj = io.BytesIO(data)
+    try:
+        elf.get_rodata_header(fobj)
+    except elf.ParseError:
+        pass
