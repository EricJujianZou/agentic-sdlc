+- key: flipt
+  name: flipt
+  rules:
+  - segment:
+      keys:
+      - all-users
+      - unknown
+      operator: AND_SEGMENT_OPERATOR
+segments:
+- key: all-users
+  name: All Users
+  match_type: ALL_MATCH_TYPE
