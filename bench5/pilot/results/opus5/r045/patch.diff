+func TestSnapshotFromPaths_InvalidReferences(t *testing.T) {
+	src := fstest.MapFS{
+		"features.yml": &fstest.MapFile{Data: []byte(`flags:
+- key: flipt
+  name: flipt
+  variants:
+  - key: fromFlipt
+  rules:
+  - segment: all-users
+    distributions:
+    - variant: unknown
+      rollout: 100
+segments:
+- key: all-users
+  name: All Users
+  match_type: ALL_MATCH_TYPE
+`)},
+	}
+
+	_, err := SnapshotFromPaths(src, "features.yml")
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), `flag default/flipt rule 0 references unknown variant "unknown"`)
+
+	_, err = SnapshotFromFS(zap.NewNop(), src)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), `flag default/flipt rule 0 references unknown variant "unknown"`)
+}
