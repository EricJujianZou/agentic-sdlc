+  rules:
+  - segment: all-users
+    distributions:
+    - variant: unknown
+      rollout: 100
+segments:
+- key: all-users
+  name: All Users
+  match_type: ALL_MATCH_TYPE
+`,
+			expected: []string{`flag production/flipt rule 0 references unknown variant "unknown" (features.yml 8:6)`},
+		},
+		{
+			name: "rule references unknown segment",
+			contents: `flags:
+- key: flipt
+  name: flipt
+  rules:
+  - segment: unknown
+`,
+			expected: []string{`flag default/flipt rule 0 references unknown segment "unknown" (features.yml 5:6)`},
+		},
