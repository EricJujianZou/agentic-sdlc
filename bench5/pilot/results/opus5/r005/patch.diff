+/**
+ * Get the holidays calendar we want to suggest to the user during the calendar setup.
+ * Result can be undefined if nothing is found
+ * The suggestion is based on the user time zone, and then on the languages set in his browser
+ */
+export const getSuggestedHolidaysCalendar = (
+    calendars: HolidaysDirectoryCalendar[],
+    tzid: string,
+    languageTags: string[]
+) => {
+    // Get all calendars in the same time zone as the user
+    const calendarsFromTimeZone = getHolidaysCalendarsFromTimeZone(calendars, tzid);
+
+    // If no option is found based on the time zone, we have nothing to suggest
+    if (!calendarsFromTimeZone.length) {
+        return undefined;
+    }
+
+    const calendarsFromCountry = getHolidaysCalendarsFromCountryCode(calendars, calendarsFromTimeZone[0].CountryCode);
+
+    if (calendarsFromCountry.length === 1) {
+        // If there is only one calendar for this country, suggest this one
+        return calendarsFromCountry[0];
+    }
+
+    // Else, several calendars are available for the same country, with different languages.
+    // Suggest the first one matching a language of the browser, by order of preference
+    for (const languageTag of languageTags) {
+        const calendarFromLanguage = findHolidaysCalendarByLanguageCode(
+            calendarsFromCountry,
+            getLanguageCode(languageTag)
+        );
+
+        if (calendarFromLanguage) {
+            return calendarFromLanguage;
+        }
+    }
+
+    // If no language matches, suggest the first calendar of the country
+    return calendarsFromCountry[0];
+};
