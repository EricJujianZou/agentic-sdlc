diff --git a/internal/server/auth/method/kubernetes/server.go b/internal/server/auth/method/kubernetes/server.go
new file mode 100644
index 00000000..115cf19c
--- /dev/null
+++ b/internal/server/auth/method/kubernetes/server.go
@@ -0,0 +1,96 @@
+package kubernetes
+
+import (
+	"context"
+	"time"
+
+	"go.flipt.io/flipt/errors"
+	"go.flipt.io/flipt/internal/config"
+	storageauth "go.flipt.io/flipt/internal/storage/auth"
+	"go.flipt.io/flipt/rpc/flipt/auth"
+	"go.uber.org/zap"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+const (
+	storageMetadataNamespace          = "io.flipt.auth.k8s.namespace"
+	storageMetadataPodName            = "io.flipt.auth.k8s.pod.name"
+	storageMetadataPodUID             = "io.flipt.auth.k8s.pod.uid"
+	storageMetadataServiceAccountName = "io.flipt.auth.k8s.serviceaccount.name"
+	storageMetadataServiceAccountUID  = "io.flipt.auth.k8s.serviceaccount.uid"
+)
+
+// Server is the core Kubernetes service account authentication server.
+// It supports a single operation VerifyServiceAccount, which takes a
+// service account token issued by the Kubernetes cluster Flipt is deployed
+// in and exchanges it for a Flipt client token.
+// The service account token is verified against the OIDC provider hosted
+// by the clusters API server.
+type Server struct {
+	logger   *zap.Logger
+	store    storageauth.Store
+	config   config.AuthenticationConfig
+	verifier tokenVerifier
+
+	auth.UnimplementedAuthenticationMethodKubernetesServiceServer
+}
+
+// New constructs and configures a new *Server.
+// It establishes a verifier for the configured Kubernetes cluster, which
+// requires both the cluster CA certificate and Flipts own service account
+// token to be readable on disk.
+func New(ctx context.Context, logger *zap.Logger, store storageauth.Store, config config.AuthenticationConfig) (*Server, error) {
+	verifier, err := newKubernetesOIDCVerifier(ctx, logger, config.Methods.Kubernetes.Method)
+	if err != nil {
+		return nil, err
+	}
+
+	return &Server{
+		logger:   logger,
+		store:    store,
+		config:   config,
+		verifier: verifier,
+	}, nil
+}
+
+// RegisterGRPC registers the server as an Server on the provided grpc server.
+func (s *Server) RegisterGRPC(server *grpc.Server) {
+	auth.RegisterAuthenticationMethodKubernetesServiceServer(server, s)
+}
+
+// VerifyServiceAccount takes a service account token, verifies it against the
+// Kubernetes clusters OIDC provider and then establishes an associated Flipt
+// client token in the backing authentication store.
+// The identity of the service account (namespace, pod and service account
+// names along with their UIDs) is retained as metadata on the resulting
+// authentication. The authentication expires when the service account token
+// which produced it expires.
+func (s *Server) VerifyServiceAccount(ctx context.Context, req *auth.VerifyServiceAccountRequest) (*auth.VerifyServiceAccountResponse, error) {
+	claims, err := s.verifier.verify(ctx, req.ServiceAccountToken)
+	if err != nil {
+		s.logger.Debug("failed to verify service account token", zap.Error(err))
+
+		return nil, errors.ErrUnauthenticatedf("verifying service account: %v", err)
+	}
+
+	clientToken, authentication, err := s.store.CreateAuthentication(ctx, &storageauth.CreateAuthenticationRequest{
+		Method:    auth.Method_METHOD_KUBERNETES,
+		ExpiresAt: timestamppb.New(time.Unix(claims.Expiration, 0)),
+		Metadata: map[string]string{
+			storageMetadataNamespace:          claims.Identity.Namespace,
+			storageMetadataPodName:            claims.Identity.Pod.Name,
+			storageMetadataPodUID:             claims.Identity.Pod.UID,
+			storageMetadataServiceAccountName: claims.Identity.ServiceAccount.Name,
+			storageMetadataServiceAccountUID:  claims.Identity.ServiceAccount.UID,
+		},
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return &auth.VerifyServiceAccountResponse{
+		ClientToken:    clientToken,
+		Authentication: authentication,
+	}, nil
+}
