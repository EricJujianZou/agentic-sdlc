new file mode 100644
index 00000000..5a9f77c7
--- /dev/null
+++ b/internal/server/auth/method/kubernetes/verifier.go
@@ -0,0 +1,126 @@
+package kubernetes
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"fmt"
+	"net/http"
+	"os"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+	"go.flipt.io/flipt/internal/config"
+	"go.uber.org/zap"
+)
+
+// tokenVerifier is the interface around verifying a service account token
+// and extracting the identity claims contained within it.
+type tokenVerifier interface {
+	verify(ctx context.Context, jwt string) (claims, error)
+}
+
+// claims is the set of claims Flipt extracts from a verified Kubernetes
+// service account token.
+type claims struct {
+	Expiration int64 `json:"exp"`
+	Identity   struct {
+		Namespace      string   `json:"namespace"`
+		Pod            resource `json:"pod"`
+		ServiceAccount resource `json:"serviceaccount"`
+	} `json:"kubernetes.io"`
+}
+
+// resource identifies a single Kubernetes resource by name and UID.
+type resource struct {
+	Name string `json:"name"`
+	UID  string `json:"uid"`
+}
+
+// kubernetesOIDCVerifier verifies service account tokens against the OIDC
+// provider served by the Kubernetes clusters API server.
+type kubernetesOIDCVerifier struct {
+	logger   *zap.Logger
+	config   config.AuthenticationMethodKubernetesConfig
+	verifier *oidc.IDTokenVerifier
+}
+
+// newKubernetesOIDCVerifier performs OIDC discovery against the configured
+// cluster issuer. Requests to the issuer are made over TLS validated with the
+// clusters certificate authority and authenticated with Flipts own service
+// account token, as the discovery and JWKS endpoints of a Kubernetes API
+// server are not generally exposed anonymously.
+func newKubernetesOIDCVerifier(ctx context.Context, logger *zap.Logger, config config.AuthenticationMethodKubernetesConfig) (*kubernetesOIDCVerifier, error) {
+	caCert, err := os.ReadFile(config.CAPath)
+	if err != nil {
+		return nil, fmt.Errorf("building kubernetes OIDC verifier: %w", err)
+	}
+
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(caCert) {
+		return nil, fmt.Errorf("building kubernetes OIDC verifier: parsing CA certificate %q", config.CAPath)
+	}
+
+	serviceAccountToken, err := os.ReadFile(config.ServiceAccountTokenPath)
+	if err != nil {
+		return nil, fmt.Errorf("building kubernetes OIDC verifier: %w", err)
+	}
+
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.TLSClientConfig = &tls.Config{
+		RootCAs:    pool,
+		MinVersion: tls.VersionTLS12,
+	}
+
+	client := &http.Client{
+		Transport: bearerTransport{
+			token: string(serviceAccountToken),
+			base:  transport,
+		},
+	}
+
+	provider, err := oidc.NewProvider(oidc.ClientContext(ctx, client), config.IssuerURL)
+	if err != nil {
+		return nil, fmt.Errorf("building kubernetes OIDC verifier: %w", err)
+	}
+
+	return &kubernetesOIDCVerifier{
+		logger: logger,
+		config: config,
+		verifier: provider.Verifier(&oidc.Config{
+			// the audiences of a service account token are decided by the
+			// cluster, so there is no single client ID for Flipt to match on.
+			// the token is instead trusted on the basis of its signature and
+			// issuer, both of which are checked here.
+			SkipClientIDCheck: true,
+		}),
+	}, nil
+}
+
+// verify checks the signature and validity of the supplied service account
+// token and returns the identity claims contained within it.
+func (k *kubernetesOIDCVerifier) verify(ctx context.Context, jwt string) (c claims, err error) {
+	token, err := k.verifier.Verify(ctx, jwt)
+	if err != nil {
+		return c, err
+	}
+
+	if err := token.Claims(&c); err != nil {
+		return c, err
+	}
+
+	return c, nil
+}
+
+// bearerTransport decorates each request with Flipts service account token,
+// which is how the Kubernetes API server authenticates the caller.
+type bearerTransport struct {
+	token string
+	base  http.RoundTripper
+}
+
+func (b bearerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	req = req.Clone(req.Context())
+	req.Header.Set("Authorization", "Bearer "+b.token)
+
+	return b.base.RoundTrip(req)
+}
