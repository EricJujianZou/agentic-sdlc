 // Meter is the default Flipt-wide otel metric Meter.
+//
+// It is backed by the global otel MeterProvider, which delegates to the
+// real provider once one is registered via otel.SetMeterProvider. This lets
+// packages create instruments at init time, before the configured exporter
+// is known.
 var Meter metric.Meter
 
 func init() {
-	// exporter registers itself on the prom client DefaultRegistrar
