-	otel.SetMeterProvider(provider)
+// GetExporter returns the configured metrics exporter as an sdkmetric.Reader,
+// along with a shutdown function which flushes and closes the exporter.
+//
+// Supports Prometheus and OTLP. The Prometheus exporter registers itself on
+// the prom client DefaultRegisterer, which is what backs the /metrics HTTP
+// endpoint. The OTLP endpoint may be given as http://…, https://…, grpc://…
+// or a bare host:port.
+func GetExporter(ctx context.Context, cfg *config.MetricsConfig) (sdkmetric.Reader, func(context.Context) error, error) {
+	var (
+		reader       sdkmetric.Reader
+		shutdownFunc = func(context.Context) error { return nil }
+	)
+
+	switch cfg.Exporter {
+	case config.MetricsPrometheus:
+		// exporter registers itself on the prom client DefaultRegisterer
+		exp, err := prometheus.New()
+		if err != nil {
+			return nil, nil, fmt.Errorf("creating prometheus exporter: %w", err)
+		}
+
+		reader = exp
+		shutdownFunc = exp.Shutdown
+
+	case config.MetricsOTLP:
+		u, err := url.Parse(cfg.OTLP.Endpoint)
+		if err != nil {
+			return nil, nil, fmt.Errorf("parsing otlp endpoint: %w", err)
+		}
+
+		var exp sdkmetric.Exporter
+
+		switch u.Scheme {
+		case "http", "https":
+			exp, err = otlpmetrichttp.New(ctx,
+				otlpmetrichttp.WithEndpoint(u.Host+u.Path),
+				otlpmetrichttp.WithHeaders(cfg.OTLP.Headers),
+			)
+		case "grpc":
+			// TODO: support additional configuration options
+			exp, err = otlpmetricgrpc.New(ctx,
+				otlpmetricgrpc.WithEndpoint(u.Host+u.Path),
+				otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+				// TODO: support TLS
+				otlpmetricgrpc.WithInsecure(),
+			)
+		default:
+			// because of url parsing ambiguity, we'll assume that the endpoint is a host:port with no scheme
+			exp, err = otlpmetricgrpc.New(ctx,
+				otlpmetricgrpc.WithEndpoint(cfg.OTLP.Endpoint),
+				otlpmetricgrpc.WithHeaders(cfg.OTLP.Headers),
+				// TODO: support TLS
+				otlpmetricgrpc.WithInsecure(),
+			)
+		}
+
+		if err != nil {
+			return nil, nil, fmt.Errorf("creating otlp metrics exporter: %w", err)
+		}
+
+		reader = sdkmetric.NewPeriodicReader(exp)
+		shutdownFunc = exp.Shutdown
+
+	default:
+		return nil, nil, fmt.Errorf("unsupported metrics exporter: %s", cfg.Exporter)
+	}
 
-	Meter = provider.Meter("github.com/flipt-io/flipt")
+	return reader, shutdownFunc, nil
 }
 
