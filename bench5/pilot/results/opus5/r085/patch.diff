+// parseInstalledPackagesLineFromRepoquery in method form, to match the other
+// line parsers on redhatBase.
+func (o *redhatBase) parseInstalledPackagesLineFromRepoquery(line string) (models.Package, error) {
+	return parseInstalledPackagesLineFromRepoquery(line)
+}
+
+// parseInstalledPackagesLineFromRepoquery parses a line of
+// `repoquery --installed --qf "%{NAME} %{EPOCH} %{VERSION} %{RELEASE} %{ARCH} %{UI_FROM_REPO}"`,
+// e.g. `yum-utils 0 1.1.31 46.amzn2.0.1 noarch @amzn2-core`
+func parseInstalledPackagesLineFromRepoquery(line string) (models.Package, error) {
+	fields := strings.Fields(line)
+	if len(fields) != 6 {
+		return models.Package{}, xerrors.Errorf("Failed to parse package line: %s", line)
+	}
+
+	ver := ""
+	epoch := fields[1]
+	if epoch == "0" || epoch == "(none)" {
+		ver = fields[2]
+	} else {
+		ver = fmt.Sprintf("%s:%s", epoch, fields[2])
+	}
+
+	// UI_FROM_REPO is `installed` for the packages that come with the AMI,
+	// they are provided by the core repository.
+	repo := strings.TrimPrefix(fields[5], "@")
+	if repo == "installed" {
+		repo = "amzn2-core"
+	}
+
+	return models.Package{
+		Name:       fields[0],
+		Version:    ver,
+		Release:    fields[3],
+		Arch:       fields[4],
+		Repository: repo,
+	}, nil
+}
+
+func (o *redhatBase) isAmazonLinux2() bool {
+	if o.Distro.Family != constant.Amazon {
+		return false
+	}
+	ss := strings.Fields(o.Distro.Release)
+	return len(ss) > 0 && ss[0] == "2"
+}
